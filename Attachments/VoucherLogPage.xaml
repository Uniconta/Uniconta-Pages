<Pages:GridBasePage xmlns:UC="clr-namespace:UnicontaClient.Pages;assembly=UnicontaPages"
x:Class="UnicontaClient.Pages.CustomPage.VoucherLogPage"
    xmlns:Pages="clr-namespace:Uniconta.ClientTools.Page;assembly=ClientTools"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ClientTools="clr-namespace:Uniconta.ClientTools;assembly=ClientTools"
    xmlns:CorasauControls="clr-namespace:Uniconta.ClientTools.Controls;assembly=ClientTools"
    xmlns:localPage="clr-namespace:UnicontaClient.Pages.CustomPage">
    <Grid x:Name="LayoutRoot" Background="{StaticResource LayoutGridColor}">
        <Grid.Resources>
            <localPage:VoucherStatusBrushConverter x:Key="VoucherStatusBrushConverter" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="150" />
        </Grid.RowDefinitions>
        <CorasauControls:CorasauRibbonControl x:Name="localMenu" XMLSourcePath=";component/Assets/GridRibbon.xml" />
        <CorasauControls:BusyIndicator x:Name="busyIndicator"
            Grid.Row="1"
            BusyContent="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=LoadingMsg}">
            <localPage:VoucherLogGrid x:Name="dgVoucherLog" AutoGenerateColumns="None">
                <localPage:VoucherLogGrid.Columns>
                    <localPage:CorasauDataGridTemplateColumnClient x:Name="StatusIndicator" FieldName="_Status" Header="" Width="30" AllowEditing="False" ReadOnly="True" IsEditSettingSet="True">
                        <localPage:CorasauDataGridTemplateColumnClient.DisplayTemplate>
                            <ControlTemplate>
                                <Ellipse Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Fill="{Binding DataContext.RowData.Row.Status, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource VoucherStatusBrushConverter}}"
                                    ToolTip="{Binding DataContext.RowData.Row.Status, RelativeSource={RelativeSource TemplatedParent}}" />
                            </ControlTemplate>
                        </localPage:CorasauDataGridTemplateColumnClient.DisplayTemplate>
                    </localPage:CorasauDataGridTemplateColumnClient>
                    <localPage:CorasauDataGridTemplateColumnClient x:Name="Status" Width="75" AllowEditing="False" ReadOnly="True" />
                    <localPage:CorasauDataGridTemplateColumnClient x:Name="PrimaryKeyId" Width="50" AllowEditing="False" ReadOnly="True" />
                    <localPage:CorasauDataGridTemplateColumnClient x:Name="Created" Width="100" AllowEditing="False" ReadOnly="True" />
                    <localPage:CorasauDataGridTemplateColumnClient x:Name="UserName" Width="150" AllowEditing="False" ReadOnly="True" />
                    <localPage:CorasauDataGridTemplateColumnClient x:Name="Text" Width="150" AllowEditing="False" ReadOnly="True" />
                </localPage:VoucherLogGrid.Columns>
            </localPage:VoucherLogGrid>
        </CorasauControls:BusyIndicator>
        <GroupBox Grid.Row="2" Margin="4" Header="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=Message}">
            <TextBox Text="{Binding SelectedItem.ErrorMessage, ElementName=dgVoucherLog, Mode=OneWay}" IsReadOnly="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="4" />
        </GroupBox>
    </Grid>
</Pages:GridBasePage>
