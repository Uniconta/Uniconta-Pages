<Pages:GridBasePage xmlns:UC="clr-namespace:UnicontaClient.Pages;assembly=UnicontaPages"
x:Class="UnicontaClient.Pages.CustomPage.VoucherScanCorrectionPage"
    xmlns:Pages="clr-namespace:Uniconta.ClientTools.Page;assembly=ClientTools"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ClientTools="clr-namespace:Uniconta.ClientTools;assembly=ClientTools"
    xmlns:CorasauControls="clr-namespace:Uniconta.ClientTools.Controls;assembly=ClientTools"
    xmlns:localPage="clr-namespace:UnicontaClient.Pages.CustomPage">
    <Grid x:Name="LayoutRoot" Background="{StaticResource LayoutGridColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <CorasauControls:CorasauRibbonControl x:Name="localMenu" XMLSourcePath=";component/Assets/GridRibbon.xml" />
        <CorasauControls:BusyIndicator x:Name="busyIndicator"
            Grid.Row="1"
            BusyContent="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=LoadingMsg}">
            <localPage:VoucherScanCorrectionGrid x:Name="dgVoucherScanCorrection" AutoGenerateColumns="None">
                <localPage:VoucherScanCorrectionGrid.Columns>
                    <localPage:CorasauDataGridTemplateColumnClient x:Name="CreditorAccount" Width="150" />
                    <localPage:CorasauDataGridTemplateColumnClient x:Name="CreditorName" Width="150" />
                    <localPage:CorasauDataGridTemplateColumnClient x:Name="DocumentRef" Width="75" />
                    <localPage:CorasauDataGridTemplateColumnClient x:Name="Content" Width="75" />
                    <localPage:CorasauDataGridTemplateColumnClient x:Name="Invoice" Width="150" />
                    <localPage:CorasauDataGridTemplateColumnClient x:Name="DocumentDate" Width="150" />
                    <localPage:CorasauDataGridTemplateColumnClient x:Name="Label" Width="100" />
                    <localPage:CorasauDataGridTemplateColumnClient x:Name="CorrectedValue" Width="150" />
                    <localPage:CorasauDataGridTemplateColumnClient x:Name="UserLogidId" Width="150" />
                </localPage:VoucherScanCorrectionGrid.Columns>
            </localPage:VoucherScanCorrectionGrid>
        </CorasauControls:BusyIndicator>
    </Grid>
</Pages:GridBasePage>
