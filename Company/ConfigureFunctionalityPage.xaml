<Pages:FormBasePage xmlns:UC="clr-namespace:UnicontaClient.Pages;assembly=UnicontaPages"
x:Class="UnicontaClient.Pages.CustomPage.ConfigureFunctionalityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:local="clr-namespace:UnicontaClient.Pages.CustomPage"
    xmlns:Pages="clr-namespace:Uniconta.ClientTools.Page;assembly=ClientTools"
    xmlns:CorasauControls="clr-namespace:Uniconta.ClientTools.Controls;assembly=ClientTools"
    mc:Ignorable="d" d:DesignHeight="900" d:DesignWidth="1500">

    <CorasauControls:BusyIndicator x:Name="busyIndicator" BusyContent="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=LoadingMsg}">
        <Grid x:Name="LayoutRoot" Background="{StaticResource LayoutGridColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <CorasauControls:CorasauRibbonControl x:Name="frmRibbon" XMLSourcePath=";component/Pages/Company/ConfigureFunctionalityPageRibbon.xml"/>

            <StackPanel Grid.Row="1" Margin="15,10,15,0" Orientation="Horizontal">
                <Label Target="{Binding ElementName=featureSearch}"
                       Content="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=Search}"/>
                <TextBox x:Name="featureSearch" Width="320" VerticalContentAlignment="Center"
                         Text="{Binding Functionality.SearchText, RelativeSource={RelativeSource AncestorType={x:Type local:ConfigureFunctionalityPage}}, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <ScrollViewer Grid.Row="2" Padding="10" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <WrapPanel x:Name="layoutItems" Orientation="Horizontal" HorizontalAlignment="Stretch"
                           DataContext="{Binding Functionality, RelativeSource={RelativeSource AncestorType={x:Type local:ConfigureFunctionalityPage}}}">

                    <local:FunctionalityModuleControl DataContext="{Binding Ledger}" IconSource="{dx:SvgImageSource Uri=/UnicontaPages;component/Assets/img/General_Ledger_16x16.svg, UsePalette=True}"/>
                    <local:FunctionalityModuleControl DataContext="{Binding Logistics}" IconSource="{dx:SvgImageSource Uri=/UnicontaPages;component/Assets/img/Inventory-New.svg, UsePalette=True}"/>
                    <local:FunctionalityModuleControl DataContext="{Binding Sales}" IconSource="{dx:SvgImageSource Uri=/UnicontaPages;component/Assets/img/Order_Confirmation_32x32.svg, UsePalette=True}"/>
                    <local:FunctionalityModuleControl DataContext="{Binding Purchase}" IconSource="{dx:SvgImageSource Uri=/UnicontaPages;component/Assets/img/PurchaseOrder.svg, UsePalette=True}"/>
                    <local:FunctionalityModuleControl DataContext="{Binding Project}" IconSource="{dx:SvgImageSource Uri=/UnicontaPages;component/Assets/img/ProjectEstimation.svg, UsePalette=True}"/>
                    <local:FunctionalityModuleControl DataContext="{Binding ProgramModules}" IconSource="{dx:SvgImageSource Uri=/UnicontaPages;component/Assets/img/AppStore.svg, UsePalette=True}"/>
                    <local:FunctionalityModuleControl DataContext="{Binding Addins}" IconSource="{dx:SvgImageSource Uri=/UnicontaPages;component/Assets/img/Add_32x32.svg, UsePalette=True}"/>
                    <local:FunctionalityModuleControl DataContext="{Binding AIAgents}" IconSource="{dx:SvgImageSource Uri=/UnicontaPages;component/Assets/img/AI.svg, UsePalette=True}"/>

                </WrapPanel>
            </ScrollViewer>
        </Grid>
    </CorasauControls:BusyIndicator>
</Pages:FormBasePage>