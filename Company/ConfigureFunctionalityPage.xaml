<Pages:FormBasePage xmlns:UC="clr-namespace:UnicontaClient.Pages;assembly=UnicontaPages"
x:Class="UnicontaClient.Pages.CustomPage.ConfigureFunctionalityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:local="clr-namespace:UnicontaClient.Pages.CustomPage"
    xmlns:Pages="clr-namespace:Uniconta.ClientTools.Page;assembly=ClientTools"
    xmlns:CorasauControls="clr-namespace:Uniconta.ClientTools.Controls;assembly=ClientTools"
    mc:Ignorable="d" d:DesignHeight="900" d:DesignWidth="1500">

    <CorasauControls:BusyIndicator x:Name="busyIndicator" BusyContent="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=LoadingMsg}">
        <Grid x:Name="LayoutRoot" Background="{StaticResource LayoutGridColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <CorasauControls:CorasauRibbonControl x:Name="frmRibbon" XMLSourcePath=";component/Pages/Company/ConfigureFunctionalityPageRibbon.xml"/>

            <ScrollViewer Grid.Row="1" Padding="10" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <WrapPanel x:Name="layoutItems" Orientation="Horizontal" HorizontalAlignment="Stretch"
                           DataContext="{Binding Functionality, RelativeSource={RelativeSource AncestorType={x:Type local:ConfigureFunctionalityPage}}}">
                    
                    <local:FunctionalityModuleControl DataContext="{Binding Basics}" IconSource="{Binding Converter={StaticResource ImageNameToImagesourceConverter}, ConverterParameter=General_Ledger_16x16}"/>
                    <local:FunctionalityModuleControl DataContext="{Binding Logistics}" IconSource="{Binding Converter={StaticResource ImageNameToImagesourceConverter}, ConverterParameter=Inventory-New}"/>
                    <local:FunctionalityModuleControl DataContext="{Binding Sales}" IconSource="{Binding Converter={StaticResource ImageNameToImagesourceConverter}, ConverterParameter=Order_Confirmation_32x32}"/>
                    <local:FunctionalityModuleControl DataContext="{Binding CRM}" IconSource="{Binding Converter={StaticResource ImageNameToImagesourceConverter}, ConverterParameter=crm-new}"/>
                    <local:FunctionalityModuleControl DataContext="{Binding Production}" IconSource="{Binding Converter={StaticResource ImageNameToImagesourceConverter}, ConverterParameter=production_32x32}"/>
                    <local:FunctionalityModuleControl DataContext="{Binding FixedAssets}" IconSource="{Binding Converter={StaticResource ImageNameToImagesourceConverter}, ConverterParameter=gl-new}"/>
                    <!--
<local:FunctionalityModuleControl DataContext="{Binding Purchase}" IconSource="{Binding Converter={StaticResource ImageNameToImagesourceConverter}, ConverterParameter=PurchaseOrder}"/>
-->
                    <local:FunctionalityModuleControl DataContext="{Binding Project}" IconSource="{Binding Converter={StaticResource ImageNameToImagesourceConverter}, ConverterParameter=project-new}"/>
                    <!--
<local:FunctionalityModuleControl DataContext="{Binding ProgramModules}" IconSource="{Binding Converter={StaticResource ImageNameToImagesourceConverter}, ConverterParameter=AppStore}"/>
-->
                    <local:FunctionalityModuleControl DataContext="{Binding Addins}" IconSource="{Binding Converter={StaticResource ImageNameToImagesourceConverter}, ConverterParameter=Add_32x32}"/>
                    <local:FunctionalityModuleControl DataContext="{Binding AIAgents}" IconSource="{Binding Converter={StaticResource ImageNameToImagesourceConverter}, ConverterParameter=AI}"/>

                </WrapPanel>
            </ScrollViewer>
        </Grid>
    </CorasauControls:BusyIndicator>
</Pages:FormBasePage>
