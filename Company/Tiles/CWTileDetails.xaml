<cw:ChildWindow xmlns:UC="clr-namespace:UnicontaClient.Pages;assembly=UnicontaPages"
x:Class="UnicontaClient.Pages.CustomPage.CWTileDetails"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:cw="clr-namespace:Uniconta.ClientTools;assembly=ClientTools"
                xmlns:controls="clr-namespace:Uniconta.ClientTools.Controls;assembly=ClientTools"
                xmlns:wizard="clr-namespace:Uniconta.ClientTools.Controls.Wizard;assembly=ClientTools"
                xmlns:local="clr-namespace:UnicontaClient.Pages.CustomPage"
                Width="840" Height="820" MinWidth="720" MinHeight="620"
                ResizeMode="CanResizeWithGrip" ShowTitle="False" WindowStyle="None" KeyDown="Wizard_KeyDown"
                Title="{Binding WelcomeTitle}" Background="{DynamicResource WizardBackgroundBrush}">
    <cw:ChildWindow.Resources>
        <Style x:Key="TileWizardLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WizardSecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,16,0,6"/>
        </Style>
        <Style x:Key="TileWizardTextEditorStyle" TargetType="controls:TextEditor">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>
        <Style x:Key="TileWizardComboBoxStyle" TargetType="controls:ComboBoxEditor">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="FilterCondition" Value="Contains"/>
            <Setter Property="IncrementalFiltering" Value="True"/>
            <Setter Property="ImmediatePopup" Value="True"/>
            <Setter Property="ValidateOnTextInput" Value="False"/>
        </Style>
        <DataTemplate DataType="{x:Type local:TileSourceStepViewModel}"><local:TileSourceStepView/></DataTemplate>
        <DataTemplate DataType="{x:Type local:TileTypeStepViewModel}"><local:TileTypeStepView/></DataTemplate>
        <DataTemplate DataType="{x:Type local:TileConfigurationStepViewModel}"><local:TileConfigurationStepView/></DataTemplate>
        <DataTemplate DataType="{x:Type local:TileParametersStepViewModel}"><local:TileParametersStepView/></DataTemplate>
        <DataTemplate DataType="{x:Type local:TilePlacementStepViewModel}"><local:TilePlacementStepView/></DataTemplate>
        <DataTemplate DataType="{x:Type local:TileReviewStepViewModel}"><local:TileReviewStepView/></DataTemplate>
    </cw:ChildWindow.Resources>
    <wizard:WizardControl>
        <wizard:WizardControl.FooterContent>
            <Button Content="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=TileDeleteTile}" Command="{Binding Data.DeleteCommand}" Style="{DynamicResource PrimaryButtonStyle}"
                    Visibility="{Binding Data.IsExisting, Converter={StaticResource bool2VisibilityConverter}}"/>
        </wizard:WizardControl.FooterContent>
    </wizard:WizardControl>
</cw:ChildWindow>
