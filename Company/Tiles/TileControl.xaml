<UserControl xmlns:UC="clr-namespace:UnicontaClient.Pages;assembly=UnicontaPages"
x:Class="UnicontaClient.Pages.CustomPage.TileControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:localPage="clr-namespace:UnicontaClient.Pages.CustomPage"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/charts"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <UserControl.Resources>
        <DataTemplate x:Key="DeleteIconTemplate">
            <Image Source="{Binding Converter={StaticResource ImageNameToImagesourceConverter}, ConverterParameter=delete_32x32}"
                   Width="18"
                   Height="18"
                   Stretch="Uniform"
                   VerticalAlignment="Center" />
        </DataTemplate>
        <Style x:Key="TileMenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="MinWidth" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WidgetTileContentStyle" TargetType="{x:Type ContentControl}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContentControl}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        


    </UserControl.Resources>

    <Grid Margin="3,3,11,11">

        <Border Padding="14,12,14,10"
                CornerRadius="10"
                BorderThickness="1"
                BorderBrush="{StaticResource LightBackgroundComponentBorder}"
                Background="{StaticResource LightBackground}"
                Effect="{StaticResource NavigationSearchPopupShadowEffect}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Menu -->
                <Button x:Name="btnEditTile"
                        Grid.Row="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Click="btnEditTile_Click"
                        Style="{StaticResource TileMenuButtonStyle}"
                        Panel.ZIndex="2"
                        FontSize="16"
                        Content="⋮"/>

                <TextBlock Grid.Row="0"
                           Text="{Binding TableName, Mode=TwoWay}"
                           TextWrapping="Wrap"
                           FontSize="14"
                           VerticalAlignment="Top"
                           HorizontalAlignment="Left"
                           Foreground="{StaticResource ForegroundBrush}"/>

                <!-- Keep the plot and its legend in separate layout columns. In particular, this
                     prevents a long pie legend from scaling (or covering) the actual chart. -->
                <Grid x:Name="ChartSurface"
                      Grid.Row="1"
                      Margin="0,8,0,2"
                      MinHeight="90"
                      Visibility="Collapsed">

                    <Grid x:Name="CustomChartSurface">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" MinWidth="70"/>
                            <ColumnDefinition Width="*" MinWidth="92"/>
                        </Grid.ColumnDefinitions>

                        <Viewbox Grid.Column="0"
                                 Stretch="Uniform"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch">
                            <Canvas x:Name="ChartCanvas" Width="210" Height="130"/>
                        </Viewbox>

                        <ScrollViewer Grid.Column="1"
                                      Margin="8,0,0,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">

                        <ScrollViewer.Resources>
                            <Style TargetType="{x:Type ScrollBar}"
                                   BasedOn="{StaticResource ThinScrollBarStyle}"/>
                        </ScrollViewer.Resources>

                            <ItemsControl x:Name="ChartLegend">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Rectangle Width="8"
                                                   Height="8"
                                                   RadiusX="2"
                                                   RadiusY="2"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"
                                                   Fill="{Binding Brush}"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DisplayText}"
                                                   FontSize="9"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource ForegroundBrush}"
                                                   ToolTip="{Binding DisplayText}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <dxc:ChartControl x:Name="PieChart"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      Background="Transparent"
                                      BorderBrush="Transparent"
                                      CrosshairEnabled="False"
                                      Visibility="Collapsed">
                        <dxc:ChartControl.Legend>
                            <dxc:Legend HorizontalPosition="RightOutside"
                                        VerticalPosition="Center"
                                        />
                        </dxc:ChartControl.Legend>
                        <dxc:SimpleDiagram2D>
                            <dxc:PieSeries2D x:Name="TilePieSeries"
                                             ArgumentDataMember="Label"
                                             ValueDataMember="Value"
                                             LegendTextPattern="{}{A}"
                                             LabelsVisibility="False"
                                             ShowInLegend="True"/>
                        </dxc:SimpleDiagram2D>
                    </dxc:ChartControl>

                    <dxc:ChartControl x:Name="TileChart"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      Background="Transparent"
                                      BorderBrush="Transparent"
                                      CrosshairEnabled="True"
                                      Visibility="Collapsed">
                        <dxc:ChartControl.Legend>
                            <dxc:Legend HorizontalPosition="RightOutside"
                                        VerticalPosition="Center"
                                        />
                        </dxc:ChartControl.Legend>
                    </dxc:ChartControl>
                </Grid>

                <!-- The browser is created in code so its native resources can be explicitly
                     released when the tile is changed or removed from the dashboard. -->
                <Grid x:Name="HtmlWidgetHost"
                      Grid.Row="1"
                      Grid.RowSpan="2"
                      Margin="0,8,0,2"
                      MinHeight="90"
                      Visibility="Collapsed"/>

                <ScrollViewer x:Name="RecordTextSurface" Grid.Row="1" Margin="0,8,0,2" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock Text="{Binding Value}" ToolTip="{Binding Value}" TextWrapping="Wrap" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource ForegroundBrush}" VerticalAlignment="Center"/>
                </ScrollViewer>

                <!-- Number -->
                <TextBlock x:Name="NumberValue"
                           Grid.Row="2"
                           Text="{Binding Value}"
                           FontSize="28"
                           Foreground="{StaticResource ForegroundBrush}"
                           Margin="0,8,0,0"
                           FontWeight="SemiBold"
                           VerticalAlignment="Bottom"
                           HorizontalAlignment="Left"/>

                <TextBlock x:Name="StatusMessage"
                           Grid.Row="1"
                           Text="{Binding StatusText}"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource ForegroundBrush}"
                           Opacity="0.7"
                           Visibility="{Binding StatusVisibility}"/>



                <!--
                <TextBlock Grid.Row="1"
                           Text="{Binding LastUpdated}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           FontSize="9"
                           Opacity="0.55"
                           Foreground="{StaticResource ForegroundBrush}"/>
                -->

                <!-- Prompt -->
                <Grid Grid.Row="3" Margin="2" VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TileTitle"
                               Grid.Column="0"
                               Text="{Binding Header, Mode=TwoWay}"
                               TextWrapping="Wrap"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Top"
                               LineHeight="16"
                               MaxHeight="36"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource ForegroundBrush}"/>

                    <Button x:Name="btnRefresh"
                            Grid.Column="1"
                            Visibility="Hidden"
                            Margin="2,3,0,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Click="btnRefresh_Click"
                            BorderThickness="0"
                            FontSize="16"
                            Content="&#10227;"/>
                </Grid>

                <!-- Purpose-built presentations are selected dynamically from the configured tile type. -->
                <ContentControl x:Name="TileTypeContent"
                                Grid.Row="0"
                                Grid.RowSpan="4"
                                Panel.ZIndex="1"
                                Visibility="Collapsed"
                                Style="{StaticResource WidgetTileContentStyle}"/>
            </Grid>
        </Border>

        <Border x:Name="ResizeSizePopup"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="10,6"
                CornerRadius="5"
                Background="{StaticResource LightBackground}"
                BorderBrush="{StaticResource LightBackgroundComponentBorder}"
                BorderThickness="1"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                Panel.ZIndex="2">

            <TextBlock x:Name="ResizeSizeText"
                       Foreground="{StaticResource ForegroundBrush}"
                       FontSize="14"
                       FontWeight="SemiBold"/>
        </Border>

        <!-- Keep tile positioning on a dedicated hit target so charts, links and the
             tile menu remain interactive. The grip is overlaid and does not affect
             the tile's content layout. -->
        <primitives:Thumb x:Name="TileDragHandle"
                          Visibility="Collapsed"
                          IsEnabled="False"
                          Width="60"
                          Height="24"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Top"
                          Cursor="SizeAll"
                          Panel.ZIndex="3"
                          ToolTip="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=TileDragTile}">
            <primitives:Thumb.Template>
                <ControlTemplate TargetType="primitives:Thumb">
                    <Grid Background="Transparent">
                        <Border x:Name="GripVisual"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Padding="7,4"
                                CornerRadius="7"
                                Background="Transparent"
                                Opacity="0.65">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="3" Height="3"
                                         Fill="{StaticResource ForegroundBrush}"/>
                                <Ellipse Width="3" Height="3" Margin="3,0"
                                         Fill="{StaticResource ForegroundBrush}"/>
                                <Ellipse Width="3" Height="3"
                                         Fill="{StaticResource ForegroundBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="GripVisual" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="GripVisual" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </primitives:Thumb.Template>
        </primitives:Thumb>

        <!-- Resize handle -->
        <primitives:Thumb x:Name="ResizeGrip"
                          Visibility="Collapsed"
                          IsEnabled="False"
                          Width="16"
                          Height="16"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Bottom"
                          Cursor="SizeNWSE"
                          DragStarted="ResizeGrip_DragStarted"
                          DragDelta="ResizeGrip_DragDelta"
                          DragCompleted="ResizeGrip_DragCompleted"
                          ToolTip="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=TileResizeTile}">

            <primitives:Thumb.Template>
                <ControlTemplate TargetType="primitives:Thumb">
                    <Grid Background="Transparent">
                        <Path Data="M 4,14 L 14,4 M 9,14 L 14,9"
                              Stroke="{StaticResource ForegroundBrush}"
                              StrokeThickness="1.2"
                              Opacity="0.42"/>
                    </Grid>
                </ControlTemplate>
            </primitives:Thumb.Template>
        </primitives:Thumb>

    </Grid>
</UserControl>
