<UserControl xmlns:UC="clr-namespace:UnicontaClient.Pages;assembly=UnicontaPages"
x:Class="UnicontaClient.Pages.CustomPage.DashboardSetupStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Uniconta.ClientTools.Controls;assembly=ClientTools">
    <StackPanel>
        <TextBlock Text="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=Name}" Style="{DynamicResource TileWizardLabelStyle}"/>
        <controls:TextEditor Text="{Binding DashboardName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource TileWizardTextEditorStyle}"/>
        <TextBlock Text="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=TileScope}" Style="{DynamicResource TileWizardLabelStyle}"/>
        <controls:ComboBoxEditor ItemsSource="{Binding ScopeOptions}" DisplayMember="Caption" ValueMember="Value" IsEditable="False"
                                 EditValue="{Binding SelectedScope, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource TileWizardComboBoxStyle}"/>
        <StackPanel Visibility="{Binding IsProfile, Converter={StaticResource bool2VisibilityConverter}}">
            <TextBlock Text="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=Profile}" Style="{DynamicResource TileWizardLabelStyle}"/>
            <controls:ComboBoxEditor ItemsSource="{Binding Profiles}" DisplayMember="Profile" IsEditable="False"
                                     SelectedItem="{Binding SelectedProfile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource TileWizardComboBoxStyle}"/>
        </StackPanel>
    </StackPanel>
</UserControl>