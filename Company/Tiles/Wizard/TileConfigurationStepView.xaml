<UserControl xmlns:UC="clr-namespace:UnicontaClient.Pages;assembly=UnicontaPages"
x:Class="UnicontaClient.Pages.CustomPage.TileConfigurationStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Uniconta.ClientTools.Controls;assembly=ClientTools">
    <StackPanel>
        <TextBlock Text="{Binding Data.SelectionSummary}" TextWrapping="Wrap" Foreground="{DynamicResource WizardSecondaryTextBrush}"/>
        <StackPanel Visibility="{Binding Data.ShowData, Converter={StaticResource bool2VisibilityConverter}}">
            <TextBlock Text="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=TileDataSource}" Style="{DynamicResource TileWizardLabelStyle}"/>
            <controls:ComboBoxEditor IsEditable="True" ItemsSource="{Binding Data.Sources}" DisplayMember="DisplayCaption"
                                     SelectedItem="{Binding Data.SelectedSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource TileWizardComboBoxStyle}" AutomationProperties.Name="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=TileDataSource}"
                                     ToolTip="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=TileDataSourceHelp}"/>
            <TextBlock Text="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=Filter}" Style="{DynamicResource TileWizardLabelStyle}"/>
            <DockPanel>
                <Button Content="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=TileEditFilter}" Command="{Binding Data.EditFiltersCommand}" DockPanel.Dock="Right" Height="32"
                        Style="{DynamicResource PrimaryButtonStyle}" Margin="8,0,0,0"
                        ToolTip="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=TileFilterHelp}"/>
                <TextBlock Text="{Binding Data.FilterSummary}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </StackPanel>
        <StackPanel Visibility="{Binding Data.ShowHtml, Converter={StaticResource bool2VisibilityConverter}}">
            <TextBlock Text="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=TileWidgetURL}" Style="{DynamicResource TileWizardLabelStyle}"/>
            <TextBlock Text="Select a country for each URL. The entry with no country is the default." TextWrapping="Wrap" Margin="0,0,0,8"/>
            <ItemsControl ItemsSource="{Binding Data.HtmlSources}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <controls:ComboBoxEditor ItemsSource="{Binding Countries}" DisplayMember="Caption"
                                SelectedItem="{Binding Country, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                AutomationProperties.Name="Country code" Margin="0,0,8,0"/>
                            <controls:TextEditor Grid.Column="1" Text="{Binding Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{DynamicResource TileWizardTextEditorStyle}" AutomationProperties.Name="Widget URL"/>
                            <Button Grid.Column="2" Content="Remove" Command="{Binding RemoveCommand}" Margin="8,0,0,0"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Add URL" Command="{Binding Data.AddHtmlSourceCommand}" HorizontalAlignment="Left"/>
        </StackPanel>
        <StackPanel Visibility="{Binding Data.ShowAggregate, Converter={StaticResource bool2VisibilityConverter}}">
            <TextBlock Text="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=TileAggregate}" Style="{DynamicResource TileWizardLabelStyle}"/>
            <controls:ComboBoxEditor IsEditable="True" DisplayMember="Caption" ValueMember="Value" ItemsSource="{Binding Data.AggregateOptions}" EditValue="{Binding Data.Aggregate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource TileWizardComboBoxStyle}" AutomationProperties.Name="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=TileAggregate}"
                                     ToolTip="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=TileAggregateHelp}"/>
        </StackPanel>
        <StackPanel Visibility="{Binding Data.ShowSingleValue, Converter={StaticResource bool2VisibilityConverter}}">
            <TextBlock Text="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=TileValueColumn}" Style="{DynamicResource TileWizardLabelStyle}"/>
            <controls:ComboBoxEditor IsEditable="True" ItemsSource="{Binding Data.NumericFields}" SelectedItem="{Binding Data.SingleValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource TileWizardComboBoxStyle}" AutomationProperties.Name="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=TileValueColumn}"
                                     ToolTip="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=TileValueColumnHelp}"/>
        </StackPanel>
        <StackPanel Visibility="{Binding Data.ShowMultipleValues, Converter={StaticResource bool2VisibilityConverter}}">
            <TextBlock Text="{Binding Data.ValueFieldLabel}" Style="{DynamicResource TileWizardLabelStyle}"/>
            <ItemsControl ItemsSource="{Binding Data.ValueFields}">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="ToolTip" Value="Compare several amounts or quantities as separate chart series. Each uses the selected aggregate calculation; Count counts records regardless of the field."/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Data.ShowAggregate}" Value="False">
                                <Setter Property="ToolTip" Value="Show these fields from the first record matching the filter. Narrow the filter to identify the record you want to see."/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <controls:CheckEditor IsChecked="{Binding IsSelected, Mode=TwoWay}" AutomationProperties.Name="{Binding Caption}"
                            ToolTip="{Binding ToolTip, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                            <TextBlock Text="{Binding Caption}" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        <StackPanel Visibility="{Binding Data.ShowGrouping, Converter={StaticResource bool2VisibilityConverter}}">
            <TextBlock Text="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=MenuColumnGroup}" Style="{DynamicResource TileWizardLabelStyle}"/>
            <controls:ComboBoxEditor IsEditable="True" ItemsSource="{Binding Data.GroupFields}" SelectedItem="{Binding Data.GroupBy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource TileWizardComboBoxStyle}" AutomationProperties.Name="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=MenuColumnGroup}"
                                     ToolTip="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=TileGroupByHelp}"/>
        </StackPanel>
        <StackPanel Visibility="{Binding Data.ShowChartGroup, Converter={StaticResource bool2VisibilityConverter}}">
            <TextBlock Text="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=TileChartGroup}" Style="{DynamicResource TileWizardLabelStyle}"/>
            <controls:ComboBoxEditor IsEditable="True" ItemsSource="{Binding Data.GroupFields}" SelectedItem="{Binding Data.ChartGroup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource TileWizardComboBoxStyle}" AutomationProperties.Name="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=TileChartGroup}"
                                     ToolTip="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=TileChartGroupHelp}"/>
        </StackPanel>
        <StackPanel Visibility="{Binding Data.ShowValue2, Converter={StaticResource bool2VisibilityConverter}}">
            <TextBlock Text="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=TileSecondValue}" Style="{DynamicResource TileWizardLabelStyle}"/>
            <controls:ComboBoxEditor IsEditable="True" ItemsSource="{Binding Data.NumericFields}" SelectedItem="{Binding Data.Value2Field, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource TileWizardComboBoxStyle}" AutomationProperties.Name="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=TileSecondValue}"
                                     ToolTip="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=TileSecondValueHelp}"/>
        </StackPanel>
        <StackPanel Visibility="{Binding Data.ShowWeight, Converter={StaticResource bool2VisibilityConverter}}">
            <TextBlock Text="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=TileBubbleWeight}" Style="{DynamicResource TileWizardLabelStyle}"/>
            <controls:ComboBoxEditor IsEditable="True" ItemsSource="{Binding Data.NumericFields}" SelectedItem="{Binding Data.WeightField, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource TileWizardComboBoxStyle}" AutomationProperties.Name="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=TileBubbleWeight}"
                                     ToolTip="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=TileBubbleWeightHelp}"/>
        </StackPanel>
        <StackPanel Visibility="{Binding Data.ShowSize, Converter={StaticResource bool2VisibilityConverter}}">
            <TextBlock Text="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=Size}" Style="{DynamicResource TileWizardLabelStyle}"/>
            <StackPanel Orientation="Horizontal">
                <controls:IntegerEditor EditValue="{Binding Data.ColumnSpan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="70" SetMinWidth="False" AutomationProperties.Name="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=Columns}"
                ToolTip="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=TileColumnSpanHelp}"/>
                <TextBlock Text=" × " VerticalAlignment="Center"/>
                <controls:IntegerEditor EditValue="{Binding Data.RowSpan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="70" SetMinWidth="False" AutomationProperties.Name="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=Rows}"
                ToolTip="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=TileRowSpanHelp}"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
