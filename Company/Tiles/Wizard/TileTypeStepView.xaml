<UserControl xmlns:UC="clr-namespace:UnicontaClient.Pages;assembly=UnicontaPages"
x:Class="UnicontaClient.Pages.CustomPage.TileTypeStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Uniconta.ClientTools.Controls;assembly=ClientTools">
    <StackPanel>
        <TextBlock Text="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=TileType}" Style="{DynamicResource TileWizardLabelStyle}"/>
        <controls:ComboBoxEditor IsEditable="True" ItemsSource="{Binding Data.TileTypes}" DisplayMember="Caption"
                                 SelectedItem="{Binding Data.SelectedTileType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource TileWizardComboBoxStyle}" AutomationProperties.Name="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=TileType}"
                                 ToolTip="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=TileTypeHelp}"/>
    </StackPanel>
</UserControl>
