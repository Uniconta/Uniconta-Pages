<UserControl xmlns:UC="clr-namespace:UnicontaClient.Pages;assembly=UnicontaPages"
x:Class="UnicontaClient.Pages.CustomPage.VoucherApprovalTileControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:UnicontaClient.Pages.CustomPage"
             xmlns:Controls="clr-namespace:Uniconta.ClientTools.Controls;assembly=ClientTools"
             xmlns:ClientControls="clr-namespace:UnicontaClient.Controls"
             mc:Ignorable="d"
             d:DesignHeight="420"
             d:DesignWidth="560">

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Color x:Key="VoucherPendingApprovalColor">#C52B3A</Color>
        <Color x:Key="VoucherApprovedColor">#10A578</Color>

        <SolidColorBrush x:Key="VoucherPendingApprovalBrush" Color="{StaticResource VoucherPendingApprovalColor}"/>
        <SolidColorBrush x:Key="VoucherApprovedBrush" Color="{StaticResource VoucherApprovedColor}"/>

        <SolidColorBrush x:Key="VoucherPendingApprovalBackgroundBrush" Color="{StaticResource VoucherPendingApprovalColor}" Opacity="0.07"/>
        <SolidColorBrush x:Key="VoucherApprovedBackgroundBrush" Color="{StaticResource VoucherApprovedColor}" Opacity="0.07"/>

        <SolidColorBrush x:Key="VoucherApproveHoverBrush" Color="{StaticResource VoucherApprovedColor}" Opacity="0.20"/>
        <SolidColorBrush x:Key="VoucherRejectHoverBrush" Color="{StaticResource VoucherPendingApprovalColor}" Opacity="0.20"/>

        <SolidColorBrush x:Key="VoucherRejectedBackgroundBrush" Color="{StaticResource VoucherPendingApprovalColor}" Opacity="0.18"/>
