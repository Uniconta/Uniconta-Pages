5 19.6748L19.6815 20.0607C19.433 20.0938 19.2475 20.3057 19.2475 20.5563V23.4302C19.2475 24.0147 19.0501 24.6625 18.525 25.0909ZM8 19.4999H9C9.55228 19.4999 10 19.0522 10 18.4999V8.49994C10 7.94766 9.55228 7.49994 9 7.49994H8C7.44772 7.49994 7 7.94766 7 8.49994V18.4999C7 19.0522 7.44772 19.4999 8 19.4999Z</Geometry>
        <Geometry x:Key="VoucherQuestionGeometry">M 12,7 C 12,1 22,1 22,7 C 22,11 17,11 17,16 M 17,20 L 17,22</Geometry>

        <Style x:Key="VoucherHeadingStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="VoucherDescriptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="Opacity" Value="0.68"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="VoucherTabButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Margin="0,0,8,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource TertiaryButtonBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TertiaryButtonForegroundBrush}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"/>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="{DynamicResource TertiaryButtonHoverBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TertiaryButtonHoverForegroundBrush}"/>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VoucherApproveButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource UnicontaButtonWithGlyph}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"
                            Value="{StaticResource VoucherApproveHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="VoucherRejectButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource UnicontaButtonWithGlyph}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"
                            Value="{StaticResource VoucherRejectHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="VoucherApprovalActionContentTemplate">
            <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"/>
        </DataTemplate>

    </UserControl.Resources>

    <Grid Background="{StaticResource LightBackground}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid x:Name="Header"
              Margin="2,0,30,8">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Viewbox Width="20"
                     Height="24"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Center">
                <Path Data="M3,1 L13,1 19,7 19,23 3,23 Z M13,1 L13,7 19,7 M7,12 L15,12 M7,16 L15,16"
                      Stroke="{DynamicResource RibbonControlTabHeaderBackground}"
                      StrokeThickness="1.8"
                      StrokeLineJoin="Round"/>
            </Viewbox>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=Vouchers}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource ForegroundBrush}"/>

                <TextBlock Text="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=TileUploadAndTrackYourInvoices}"
                           Margin="0,1,0,0"
                           FontSize="11"
                           Opacity="0.62"
                           Foreground="{StaticResource ForegroundBrush}"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="MasterDetailContent" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="PreviewColumn" Width="0"/>
            </Grid.ColumnDefinitions>
            <!-- IDLE / NORMAL STATE -->
            <ScrollViewer x:Name="IdleContentScrollViewer"
                      Grid.Column="0"
                      Grid.RowSpan="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      SizeChanged="IdleLayout_SizeChanged">

                <Grid x:Name="IdleContent" SizeChanged="IdleLayout_SizeChanged">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition x:Name="IdleFooterGap" Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- TABS -->
                    <Border x:Name="VoucherTabs"
                        Grid.Row="0"
                        SizeChanged="IdleLayout_SizeChanged"
                        Padding="4"
                        CornerRadius="10"
                        Background="{StaticResource LightBackgroundComponentBackground}"
                        BorderBrush="{StaticResource LightBackgroundComponentBorder}"
                        BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- NEEDS APPROVAL -->
                            <Button x:Name="NeedsApprovalTabButton"
                                Grid.Column="0"
                                Style="{StaticResource VoucherTabButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=VoucherTileNeedsApproval}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"/>
                                    <TextBlock x:Name="NeedsApprovalCountText" Text="0"/>
                                </StackPanel>
                            </Button>

                            <!-- AWAITING OTHERS -->
                            <Button x:Name="AwaitingOthersTabButton"
                                Grid.Column="1"
                                Style="{StaticResource VoucherTabButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=VoucherTileAwaitingOthers}" TextAlignment="Center" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="AwaitingOthersCountText" Text="0"/>
                                </StackPanel>
                            </Button>

                            <!-- APPROVED -->
                            <Button x:Name="ApprovedTabButton"
                                Grid.Column="2"
                                Style="{StaticResource VoucherTabButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=Approved}" TextAlignment="Center"/>
                                    <TextBlock x:Name="ApprovedCountText" Text="0"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- VOUCHER LIST -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <ClientControls:SearchInput x:Name="VoucherSearch"
                                          Grid.Row="0"
                                          Height="32"
                                          Margin="0,0,0,10"
                                          Placeholder="Search vouchers"
                                          SearchTextChanged="VoucherSearch_TextChanged"/>
                        <ScrollViewer x:Name="VoucherListScrollViewer"
                                  Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="VoucherListScrollViewer_PreviewMouseWheel">

                            <ListBox x:Name="VoucherList"
                                 SelectionMode="Single"
                                 SelectionChanged="VoucherList_SelectionChanged"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 HorizontalContentAlignment="Stretch">
                                <ListBox.Template>
                                    <ControlTemplate TargetType="{x:Type ListBox}">
                                        <ItemsPresenter/>
                                    </ControlTemplate>
                                </ListBox.Template>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="{x:Type ListBoxItem}">
                                        <EventSetter Event="MouseDoubleClick" Handler="VoucherItem_MouseDoubleClick"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                    <ContentPresenter HorizontalAlignment="Stretch"/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>

                                        <Border x:Name="VoucherBorder"
                                            Margin="0,0,0,5"
                                            Padding="9,7"
                                            Background="{StaticResource LightBackgroundComponentBackground}"
                                            BorderBrush="{StaticResource LightBackgroundComponentBorder}"
                                            BorderThickness="2"
                                            CornerRadius="8">

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <!-- RESPONSIVE INLINE ACTIONS -->
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- DOWNLOAD -->
                                                <Button Width="36"
                                                    Height="40"
                                                    Padding="0"
                                                    BorderThickness="0"
                                                    Background="Transparent"
                                                    Cursor="Hand"
                                                    Click="Download_Click">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="#0D5145D9"
                                                                CornerRadius="6">
                                                                <Image Source="{Binding Converter={StaticResource ImageNameToImagesourceConverter}, ConverterParameter=download-32x32}"
                                                                   IsHitTestVisible="False"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <!-- VOUCHER INFORMATION -->
                                                <StackPanel Grid.Column="2"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource ForegroundBrush}"
                                                           TextTrimming="CharacterEllipsis"/>

                                                    <StackPanel Margin="0,2,0,0"
                                                            Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DateText}"
                                                               FontSize="11"
                                                               Opacity="0.58"
                                                               Foreground="{StaticResource ForegroundBrush}"/>
                                                        <TextBlock Text="  ·  "
                                                               FontSize="11"
                                                               Opacity="0.45"
                                                               Foreground="{StaticResource ForegroundBrush}"/>
                                                        <TextBlock Text="{Binding AmountText}"
                                                               FontSize="11"
                                                               Opacity="0.58"
                                                               Foreground="{StaticResource ForegroundBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <!-- INLINE APPROVE / REJECT -->
                                                <StackPanel Grid.Column="3"
                                                            Visibility="Collapsed"
                                                         Orientation="Horizontal"
                                                         VerticalAlignment="Center"
                                                         Margin="8,0,0,0">

                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsWideLayout, RelativeSource={RelativeSource AncestorType={x:Type local:VoucherApprovalTileControl}}}" Value="True"/>
                                                                        <Condition Binding="{Binding Tag, Source={x:Reference NeedsApprovalTabButton}}" Value="True"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <Button Style="{StaticResource VoucherApproveButtonStyle}" Width="32"
                                                                  Height="32"
                                                                  MinWidth="0"
                                                                  MinHeight="0"
                                                                  Padding="0"
                                                                  Controls:ButtonAppearance.IconOnly="True"
                                                                  Controls:ButtonAppearance.ShowBorder="False"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  Controls:ButtonAppearance.Variant="Primary"
                                                                  Controls:ButtonAppearance.Glyph="{Binding Converter={StaticResource ImageNameToImagesourceConverter}, ConverterParameter=approve_byemployee_32x32.svg}"
                                                                  Tag="{Binding}"
                                                                  ToolTip="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=Approve}"
                                                                  Click="InlineApprove_Click"/>

                                                    <Button Style="{StaticResource VoucherRejectButtonStyle}" Width="32"
                                                                  Height="32"
                                                                  MinWidth="0"
                                                                  MinHeight="0"
                                                                  Padding="0"
                                                                  Controls:ButtonAppearance.IconOnly="True"
                                                                  Controls:ButtonAppearance.ShowBorder="False"
                                                                  Margin="4,0,0,0"
                                                                  Controls:ButtonAppearance.Variant="Primary"
                                                                  Controls:ButtonAppearance.Glyph="{Binding Converter={StaticResource ImageNameToImagesourceConverter}, ConverterParameter=thumbsdown_32x32.svg}"
                                                                  Tag="{Binding}"
                                                                  ToolTip="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=Reject}"
                                                                  Click="InlineReject_Click"/>
                                                </StackPanel>

                                                <!-- APPROVERS -->
                                                <StackPanel Grid.Column="4">

                                                    <!-- APPROVER 1 -->
                                                    <Border Margin="8,0,0,2" Padding="9,4" CornerRadius="10"
                                                            VerticalAlignment="Center" Visibility="{Binding Approver1Visibility}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource LightBackgroundComponentBackground}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Approver1Approved}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource VoucherApprovedBackgroundBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Approver1Rejected}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource VoucherRejectedBackgroundBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Viewbox Width="16" Height="16" Margin="0,0,4,0" VerticalAlignment="Center">
                                                                <Canvas Width="32" Height="32">
                                                                    <Path>
                                                                        <Path.Style>
                                                                            <Style TargetType="Path">
                                                                                <Setter Property="Data" Value="{StaticResource VoucherQuestionGeometry}"/>
                                                                                <Setter Property="Stroke" Value="{DynamicResource NavigationSearchPopupSecondaryTextBrush}"/>
                                                                                <Setter Property="StrokeThickness" Value="2.5"/>
                                                                                <Setter Property="ToolTip" Value="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=VoucherTileNotYetApproved}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Approver1Approved}" Value="True">
                                                                                        <Setter Property="Data" Value="{StaticResource VoucherThumbsUpGeometry}"/>
                                                                                        <Setter Property="StrokeThickness" Value="0"/>
                                                                                        <Setter Property="Fill" Value="{StaticResource VoucherApprovedBrush}"/>
                                                                                        <Setter Property="ToolTip" Value="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=Approved}"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Approver1Rejected}" Value="True">
                                                                                        <Setter Property="Data" Value="{StaticResource VoucherThumbsDownGeometry}"/>
                                                                                        <Setter Property="StrokeThickness" Value="0"/>
                                                                                        <Setter Property="Fill" Value="{StaticResource VoucherPendingApprovalBrush}"/>
                                                                                        <Setter Property="ToolTip" Value="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=Rejected}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Path.Style>
                                                                    </Path>
                                                                </Canvas>
                                                            </Viewbox>
                                                            <TextBlock Text="{Binding Approver1}" FontSize="12" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Approver1Approved}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource VoucherApprovedBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- APPROVER 2 -->
                                                    <Border Margin="8,0,0,2" Padding="9,4" CornerRadius="10"
                                                            VerticalAlignment="Center" Visibility="{Binding Approver2Visibility}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource LightBackgroundComponentBackground}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Approver2Approved}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource VoucherApprovedBackgroundBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Approver2Rejected}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource VoucherRejectedBackgroundBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Viewbox Width="16" Height="16" Margin="0,0,4,0" VerticalAlignment="Center">
                                                                <Canvas Width="32" Height="32">
                                                                    <Path>
                                                                        <Path.Style>
                                                                            <Style TargetType="Path">
                                                                                <Setter Property="Data" Value="{StaticResource VoucherQuestionGeometry}"/>
                                                                                <Setter Property="Stroke" Value="{DynamicResource NavigationSearchPopupSecondaryTextBrush}"/>
                                                                                <Setter Property="StrokeThickness" Value="2.5"/>
                                                                                <Setter Property="ToolTip" Value="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=VoucherTileNotYetApproved}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Approver2Approved}" Value="True">
                                                                                        <Setter Property="Data" Value="{StaticResource VoucherThumbsUpGeometry}"/>
                                                                                        <Setter Property="StrokeThickness" Value="0"/>
                                                                                        <Setter Property="Fill" Value="{StaticResource VoucherApprovedBrush}"/>
                                                                                        <Setter Property="ToolTip" Value="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=Approved}"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Approver2Rejected}" Value="True">
                                                                                        <Setter Property="Data" Value="{StaticResource VoucherThumbsDownGeometry}"/>
                                                                                        <Setter Property="StrokeThickness" Value="0"/>
                                                                                        <Setter Property="Fill" Value="{StaticResource VoucherPendingApprovalBrush}"/>
                                                                                        <Setter Property="ToolTip" Value="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=Rejected}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Path.Style>
                                                                    </Path>
                                                                </Canvas>
                                                            </Viewbox>
                                                            <TextBlock Text="{Binding Approver2}" FontSize="12" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Approver2Approved}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource VoucherApprovedBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>

                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                                                     Value="True">
                                                <Setter TargetName="VoucherBorder"
                                                    Property="BorderBrush"
                                                    Value="{DynamicResource NavigationSearchPopupItemSelectedBorderBrush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>


                        <!-- EMPTY LIST -->
                        <Grid x:Name="EmptyVoucherList"
                          Grid.Row="1"
                          Visibility="Collapsed"
                          Margin="8,6"
                          MinHeight="180">

                            <!-- Rounded dashed border -->
                            <Rectangle RadiusX="10"
                                   RadiusY="10"
                                   Stroke="#D1D5DB"
                                   StrokeThickness="1.5"
                                   StrokeDashArray="4,4"
                                   Fill="Transparent"
                                   SnapsToDevicePixels="True"/>

                            <!-- Empty state content -->
                            <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="24">

                                <Image Source="{Binding Converter={StaticResource ImageNameToImagesourceConverter}, ConverterParameter=upload_32x32.svg}"
                                   Width="32"
                                   Height="32"
                                   Opacity="0.65"
                                   HorizontalAlignment="Center"/>

                                <TextBlock x:Name="EmptyVoucherListText"
                                       Text="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=TileDragYourVoucherAttachmentsHereToUpload}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="240"
                                       Margin="0,16,0,0"
                                       FontSize="14"
                                       Foreground="{StaticResource ForegroundBrush}"
                                       Opacity="0.65"/>
                            </StackPanel>
                        </Grid>

                    </Grid>

                    <!-- ADD VOUCHER -->
                    <Button Style="{DynamicResource UnicontaButtonWithGlyph}" x:Name="AddVoucherButton"
                                  Grid.Row="4"
                                  SizeChanged="IdleLayout_SizeChanged"
                                  Controls:ButtonAppearance.Glyph="{Binding Converter={StaticResource ImageNameToImagesourceConverter}, ConverterParameter=Add_16x16.svg}"
                                  Content="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=TileAddVoucher}"
                                  Controls:ButtonAppearance.Variant="Tertiary"
                                  Click="AddInvoiceButton_Click"/>

                    <!-- APPROVAL ACTIONS -->
                    <UniformGrid x:Name="ApprovalActions"
                             Grid.Row="4"
                             Columns="2"
                             Visibility="Collapsed"
                             SizeChanged="IdleLayout_SizeChanged">

                        <Button Style="{StaticResource VoucherApproveButtonStyle}" x:Name="ApproveButton"
                                      Controls:ButtonAppearance.Variant="Primary"
                                      Controls:ButtonAppearance.Glyph="{Binding Converter={StaticResource ImageNameToImagesourceConverter}, ConverterParameter=approve_byemployee_32x32.svg}"
                                      Content="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=Approve}"
                                      ContentTemplate="{StaticResource VoucherApprovalActionContentTemplate}"
                                      Height="Auto"
                                      MinHeight="44"
                                      MinWidth="0"
                                      HorizontalContentAlignment="Stretch"
                                      Margin="2"
                                      IsEnabled="False"
                                      Click="ApproveButton_Click"/>

                        <Button Style="{StaticResource VoucherApproveButtonStyle}" x:Name="ApproveWithCommentButton"
                                      Controls:ButtonAppearance.Variant="Primary"
                                      Controls:ButtonAppearance.Glyph="{Binding Converter={StaticResource ImageNameToImagesourceConverter}, ConverterParameter=approve_byadmin_32x32.svg}"
                                      Content="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=ApproveWithComments}"
                                      ContentTemplate="{StaticResource VoucherApprovalActionContentTemplate}"
                                      Height="Auto"
                                      MinHeight="44"
                                      MinWidth="0"
                                      HorizontalContentAlignment="Stretch"
                                      Margin="2"
                                      IsEnabled="False"
                                      Click="ApproveWithCommentButton_Click"/>

                        <Button Style="{StaticResource VoucherRejectButtonStyle}" x:Name="RejectButton"
                                      Controls:ButtonAppearance.Variant="Primary"
                                      Controls:ButtonAppearance.Glyph="{Binding Converter={StaticResource ImageNameToImagesourceConverter}, ConverterParameter=thumbsdown_32x32.svg}"
                                      Content="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=Reject}"
                                      ContentTemplate="{StaticResource VoucherApprovalActionContentTemplate}"
                                      Height="Auto"
                                      MinHeight="44"
                                      MinWidth="0"
                                      HorizontalContentAlignment="Stretch"
                                      Margin="2"
                                      IsEnabled="False"
                                      Click="RejectButton_Click"/>

                        <Button Style="{DynamicResource UnicontaButtonWithGlyph}" x:Name="NewApproverButton"
                                      Controls:ButtonAppearance.Variant="Primary"
                                      Controls:ButtonAppearance.Glyph="{Binding Converter={StaticResource ImageNameToImagesourceConverter}, ConverterParameter=Change_Ownership_32x32.svg}"
                                      Content="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=VoucherTileNewApprover}"
                                      ContentTemplate="{StaticResource VoucherApprovalActionContentTemplate}"
                                      Height="Auto"
                                      MinHeight="44"
                                      MinWidth="0"
                                      HorizontalContentAlignment="Stretch"
                                      Margin="2"
                                      IsEnabled="False"
                                      Click="NewApproverButton_Click"/>
                    </UniformGrid>
                </Grid>
            </ScrollViewer>

            <Border x:Name="PreviewPanel" Grid.Column="1" Margin="12,0,0,0"
                    SizeChanged="IdleLayout_SizeChanged"
                    Visibility="Collapsed"
                    Background="{StaticResource LightBackgroundComponentBackground}"
                    BorderBrush="{StaticResource LightBackgroundComponentBorder}" BorderThickness="0">
                <Grid>
                    <ContentControl x:Name="PreviewContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                    <TextBlock x:Name="PreviewMessage" Text="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=TileSelectAVoucherToPreview}"
                               Style="{StaticResource VoucherDescriptionStyle}" Margin="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- OTHER STATES -->
        <Grid x:Name="StateContent"
              Grid.Row="1"
              Visibility="Collapsed" >

            <!-- DRAG OVER -->
            <Grid x:Name="DragOverContent"
                  Visibility="Collapsed"
                  IsHitTestVisible="False">

                <Rectangle Margin="-8,-42,-8,-8"
                           RadiusX="10"
                           RadiusY="10"
                           Stroke="{DynamicResource RibbonControlTabHeaderBackground}"
                           StrokeThickness="2"
                           StrokeDashArray="5,3"
                           Fill="#095145D9"/>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="20">

                    <Grid Width="72"
                          Height="82"
                          Margin="0,0,0,20">

                        <Path Data="M10,2 L45,2 64,21 64,78 10,78 Z M45,2 L45,21 64,21"
                              Stroke="{DynamicResource RibbonControlTabHeaderBackground}"
                              StrokeThickness="2.5"
                              Fill="Transparent"/>

                        <TextBlock Text="PDF"
                                   VerticalAlignment="Bottom"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,0,4"
                                   Padding="6,2"
                                   Background="#D43B5266"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontSize="13"/>
                    </Grid>

                    <TextBlock x:Name="DragOverTitle"
                               Style="{StaticResource VoucherHeadingStyle}"
                               FontSize="23"
                               Foreground="{DynamicResource RibbonControlTabHeaderBackground}"/>

                    <TextBlock x:Name="DragOverDescription"
                               Style="{StaticResource VoucherDescriptionStyle}"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>

            <!-- PROCESSING -->
            <Grid x:Name="ProcessingContent"
                  Visibility="Collapsed">

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="20">

                    <Grid Width="60"
                          Height="60"
                          Margin="0,0,0,20">

                        <Ellipse Stroke="#335145D9"
                                 StrokeThickness="6"/>

                        <Path Data="M30,3 A27,27 0 0 1 57,30"
                              Stroke="{DynamicResource RibbonControlTabHeaderBackground}"
                              StrokeThickness="6"
                              StrokeStartLineCap="Round"
                              Fill="Transparent">

                            <Path.RenderTransform>
                                <RotateTransform x:Name="ProcessingRotation"
                                                 CenterX="30"
                                                 CenterY="30"/>
                            </Path.RenderTransform>
                        </Path>
                    </Grid>

                    <TextBlock x:Name="ProcessingTitle"
                               Style="{StaticResource VoucherHeadingStyle}"
                               FontSize="18"/>

                    <TextBlock x:Name="ProcessingDescription"
                               Style="{StaticResource VoucherDescriptionStyle}"
                               Margin="0,7,0,0"/>
                </StackPanel>
            </Grid>

            <!-- SUCCESS -->
            <Grid x:Name="SuccessContent"
                  Visibility="Collapsed">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="20,8">

                    <Border Width="70"
                            Height="70"
                            CornerRadius="35"
                            Background="#1810A578"
                            Margin="0,0,0,18">

                        <Path Data="M18,36 L29,47 52,23"
                              Stroke="{StaticResource VoucherApprovedBrush}"
                              StrokeThickness="4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"/>
                    </Border>

                    <TextBlock x:Name="SuccessTitle"
                               Style="{StaticResource VoucherHeadingStyle}"
                               FontSize="19"/>

                    <TextBlock x:Name="SuccessDescription"
                               Style="{StaticResource VoucherDescriptionStyle}"
                               Margin="0,7,0,0"
                               MaxWidth="330"/>
                </StackPanel>

                <StackPanel Grid.Row="1"
                            HorizontalAlignment="Center"
                            Margin="0,8,0,0">

                    <Button Style="{DynamicResource UnicontaButtonWithGlyph}" Width="260"
                                      Controls:ButtonAppearance.Glyph="{Binding Converter={StaticResource ImageNameToImagesourceConverter}, ConverterParameter=View_16x16.svg}"
                                      Content="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=TileViewVoucher}"
                                      Controls:ButtonAppearance.Variant="Primary"
                                      Click="ViewVoucherButton_Click"/>

                    <Button Style="{DynamicResource UnicontaButtonWithGlyph}" Width="260"
                                      Margin="0,8,0,0"
                                      Controls:ButtonAppearance.Glyph="{Binding Converter={StaticResource ImageNameToImagesourceConverter}, ConverterParameter=Add_16x16.svg}"
                                      Content="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=TileAddAnotherInvoice}"
                                      Controls:ButtonAppearance.Variant="Secondary"
                                      Click="ReturnToStartButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- ERROR -->
            <Grid x:Name="ErrorContent" Visibility="Collapsed">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="20">

                    <Border Width="70"
                    Height="70"
                    CornerRadius="35"
                    Background="#18C52B3A"
                    Margin="0,0,0,18">

                        <Grid>
                            <Path Data="M22,22 L48,48 M48,22 L22,48"
                          Stroke="{StaticResource VoucherPendingApprovalBrush}"
                          StrokeThickness="4"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"/>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="ErrorTitle"
                       Style="{StaticResource VoucherHeadingStyle}"
                       FontSize="18"/>

                    <TextBlock x:Name="ErrorDescription"
                       Style="{StaticResource VoucherDescriptionStyle}"
                       Margin="0,7,0,0"
                       MaxWidth="330"/>
                </StackPanel>

                <Button Grid.Row="1"
                        x:Name="ErrorReturnToStartButton"
                        Style="{DynamicResource UnicontaButtonWithGlyph}"
                        Width="260"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0"
                        Controls:ButtonAppearance.Glyph="{Binding Converter={StaticResource ImageNameToImagesourceConverter}, ConverterParameter=Add_16x16.svg}"
                        Content="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=TileAddAnotherInvoice}"
                        Controls:ButtonAppearance.Variant="Secondary"
                        Click="ReturnToStartButton_Click"/>

            </Grid> 

        </Grid>
    </Grid>
</UserControl>
