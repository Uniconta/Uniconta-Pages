<UserControl xmlns:UC="clr-namespace:UnicontaClient.Pages;assembly=UnicontaPages"
x:Class="UnicontaClient.Pages.CustomPage.FunctionalityModuleControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:CorasauControls="clr-namespace:Uniconta.ClientTools.Controls;assembly=ClientTools"
    x:Name="ModuleControl" Visibility="{Binding Visibility}">
    <Border Style="{StaticResource FunctionalityModuleCardStyle}">
        <StackPanel>
            <Grid Style="{StaticResource FunctionalityModuleHeaderStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource FunctionalityModuleIconBackgroundStyle}"/>
                <Image Style="{StaticResource FunctionalityModuleIconStyle}"
                       Source="{Binding IconSource, ElementName=ModuleControl}"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource FunctionalityModuleModuleTitleStyle}" Text="{Binding Title}"/>
                    <TextBlock Style="{StaticResource FunctionalityModuleModuleDescriptionStyle}" Text="{Binding Description}"/>
                </StackPanel>
            </Grid>
            <ItemsControl ItemsSource="{Binding FeatureGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander Style="{StaticResource FunctionalityModuleFeaturesExpanderStyle}" Visibility="{Binding Visibility}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                            <Expander.Header>
                                <TextBlock Style="{StaticResource FunctionalityModuleFeaturesTitleStyle}"
                               Text="{Binding Title}"/>
                            </Expander.Header>

                            <Expander.ContextMenu>
                                <ContextMenu Style="{StaticResource FunctionalityModuleContextMenuStyle}">
                                    <MenuItem Style="{StaticResource FunctionalityModuleMenuItemStyle}"
                                  Header="Expand all"
                                  Click="ExpandAll_Click"/>
                                    <MenuItem Style="{StaticResource FunctionalityModuleMenuItemStyle}"
                                  Header="Collapse all"
                                  Click="CollapseAll_Click"/>
                                </ContextMenu>
                            </Expander.ContextMenu>

                            <ItemsControl Style="{StaticResource FunctionalityModuleFeatureListStyle}"
                                          ItemsSource="{Binding VisibleFeatures}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Style="{StaticResource FunctionalityModuleFeatureRowStyle}"
                                              Visibility="{Binding Visibility}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <CorasauControls:CheckEditor
                                                VerticalAlignment="Top"
                                                IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                IsEnabled="{Binding CanEdit}">
                                                <CorasauControls:CheckEditor.Style>
                                                    <Style TargetType="CorasauControls:CheckEditor"
                                                           BasedOn="{StaticResource FunctionalityModuleFeatureCheckEditorStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsComboBox}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </CorasauControls:CheckEditor.Style>
                                            </CorasauControls:CheckEditor>

                                            <Expander Grid.Column="1"
                                                      Style="{StaticResource FunctionalityModuleFeatureExpanderStyle}"
                                                      IsExpanded="{Binding IsDescriptionExpanded, Mode=TwoWay}">
                                                <Expander.Header>
                                                    <TextBlock Style="{StaticResource FunctionalityModuleFeatureTitleStyle}"
                                                               Text="{Binding Title}"/>
                                                </Expander.Header>
                                                <TextBlock Style="{StaticResource FunctionalityModuleFeatureDescriptionStyle}"
                                                           Text="{Binding Description}"/>
                                            </Expander>

                                            <CorasauControls:ComboBoxEditor Grid.Row="1" Grid.Column="1"
                                                ItemsSource="{Binding Items}"
                                                SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                                                IsEnabled="{Binding CanEdit}">
                                                <CorasauControls:ComboBoxEditor.Style>
                                                    <Style TargetType="CorasauControls:ComboBoxEditor"
                                                           BasedOn="{StaticResource FunctionalityModuleFeatureComboBoxEditorStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsComboBox}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </CorasauControls:ComboBoxEditor.Style>
                                            </CorasauControls:ComboBoxEditor>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
