<Pages:GridBasePage xmlns:UC="clr-namespace:UnicontaClient.Pages;assembly=UnicontaPages"
x:Class="UnicontaClient.Pages.CustomPage.UserAssociateGridPage" 
           xmlns:Pages="clr-namespace:Uniconta.ClientTools.Page;assembly=ClientTools"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
           xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
           xmlns:CorasauControls="clr-namespace:Uniconta.ClientTools.Controls;assembly=ClientTools" 
           xmlns:converter="clr-namespace:Uniconta.ClientTools.Util;assembly=ClientTools"
           xmlns:localPage="clr-namespace:UnicontaClient.Pages.CustomPage" 
           xmlns:editor="http://schemas.devexpress.com/winfx/2008/xaml/editors">
    <UserControl.Resources>
        <converter:VisibilityBoolConverter x:Key="VisibilityBoolConverter" />
    </UserControl.Resources>
    <Grid x:Name="LayoutRoot" Background="{StaticResource LayoutGridColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <CorasauControls:CorasauRibbonControl x:Name="localMenu" XMLSourcePath=";component/Assets/GridRibbonReadOnly.xml" Grid.Row="0"/>
        <CorasauControls:BusyIndicator x:Name="busyIndicator" Grid.Row="1" BusyContent="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=LoadingMsg}">
            <localPage:UserAssociateGrid x:Name="dgAssociateGrid" AutoGenerateColumns="None">
                <localPage:UserAssociateGrid.Columns>
                    <localPage:CorasauDataGridTemplateColumnClient x:Name="Key" Width="450"/>
                    <localPage:CorasauDataGridTemplateColumnClient x:Name="ValidFrom" Width="100"/>
                    <localPage:CorasauDataGridTemplateColumnClient x:Name="ValidTo" Width="100"/>
                    <localPage:CorasauDataGridTemplateColumnClient x:Name="Comment"  Width="200"/>
                    <localPage:CorasauDataGridTemplateColumnClient x:Name="ForCompanyId" Width="100"/>
                    <localPage:CorasauDataGridTemplateColumnClient x:Name="Blocked" Width="60"/>
                </localPage:UserAssociateGrid.Columns>
            </localPage:UserAssociateGrid>
        </CorasauControls:BusyIndicator>
    </Grid>
</Pages:GridBasePage>
