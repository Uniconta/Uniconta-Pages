<cw:ChildWindow xmlns:UC="clr-namespace:UnicontaClient.Pages;assembly=UnicontaPages"
x:Class="UnicontaClient.Pages.CustomPage.CWReturnReason"
             xmlns:cw="clr-namespace:Uniconta.ClientTools;assembly=ClientTools"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UnicontaClient.Pages.CustomPage"
             xmlns:Util="clr-namespace:Uniconta.ClientTools.Util;assembly=ClientTools"
             xmlns:CorasauControls="clr-namespace:Uniconta.ClientTools.Controls;assembly=ClientTools"
             Width="300" Height="320" KeyDown="ChildWindow_KeyDown">
    <cw:ChildWindow.Resources>
            <Util:MaskConverter x:Key="MaskConverter" />
    </cw:ChildWindow.Resources>
    <Grid Margin="2" x:Name="LayoutRoot" >
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid VerticalAlignment="Center" Margin="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="5" />
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="5" />
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="5" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
           
            <TextBlock x:Name="lblRecordType" Text="{Binding Converter={StaticResource  GlobalLocalizationValueConverter},ConverterParameter=RecordType,Mode=OneWay}" Grid.Column="0" Grid.Row="0" VerticalAlignment="Center"/>
            <CorasauControls:ComboBoxEditor x:Name="cmbRecordType"  SelectedItem="{Binding RecordType,Mode=TwoWay}" Height="25" Grid.Column="2" Grid.Row="0" HorizontalAlignment="Stretch"/>

            <TextBlock x:Name="lblReturnReason" Text="{Binding Converter={StaticResource  GlobalLocalizationValueConverter},ConverterParameter=ReturnReason,Mode=OneWay}"  Grid.Column="0" Grid.Row="2" VerticalAlignment="Center"/>
            <CorasauControls:ComboBoxEditor x:Name="ReturnReason"  SelectedItem="{Binding ReturnReason,Mode=TwoWay}" Height="25" Grid.Column="2" Grid.Row="2" HorizontalAlignment="Stretch"/>
           
            <TextBlock Text="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=Reason}" Grid.Column="0" Grid.Row="4"/>
            <CorasauControls:LookupEditor x:Name="leReason" Grid.Column="2" Grid.Row="4" Text="{Binding Reason,Mode=TwoWay}"/>

            <TextBlock  Grid.Row="6" Text="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=Scrap}" VerticalAlignment="Center"></TextBlock>
            <CorasauControls:CheckEditor IsChecked="{Binding Scrap, Mode=TwoWay}" Grid.Row="6" x:Name="chkScrap" Grid.Column="2" Height="25"/>
           
            <TextBlock  Grid.Row="8" Text="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=FromInvoice}" VerticalAlignment="Center"></TextBlock>
            <CorasauControls:AccountEditor Text="{Binding FromInvoice, Mode=TwoWay}" Grid.Row="8" x:Name="txtFromInvoice" Grid.Column="2" Height="25" HorizontalAlignment="Stretch"/>

            <TextBlock x:Name="tblComments" Grid.Row="10" Text="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=Comment}" VerticalAlignment="Center"></TextBlock>
            <CorasauControls:TextEditor Text="{Binding Comment, Mode=TwoWay}" Grid.Row="10" x:Name="txtComments" Grid.Column="2" Height="25" HorizontalAlignment="Stretch"/>
        </Grid>
        <StackPanel x:Name="actionButton" HorizontalAlignment="Right" Grid.Row="1" Orientation="Horizontal" Margin="0 10 0 0">
            <Button x:Name="OKButton" IsDefault="True" Content="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=OK}" Click="OKButton_Click" MinWidth="75" Height="23" 
                    HorizontalAlignment="Right" Margin="0 0 3 0" />
            <Button x:Name="CancelButton" IsCancel="True" Content="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=Cancel}" Click="CancelButton_Click" MinWidth="75" 
                    Height="23" HorizontalAlignment="Right"  />
        </StackPanel>
    </Grid>
</cw:ChildWindow>
