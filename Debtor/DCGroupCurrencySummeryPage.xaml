<Pages:GridBasePage xmlns:UC="clr-namespace:UnicontaClient.Pages;assembly=UnicontaPages"
x:Class="UnicontaClient.Pages.CustomPage.DCGroupCurrencySummeryPage"
           xmlns:Pages="clr-namespace:Uniconta.ClientTools.Page;assembly=ClientTools"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:ClientTools="clr-namespace:Uniconta.ClientTools;assembly=ClientTools"
           xmlns:CorasauControls="clr-namespace:Uniconta.ClientTools.Controls;assembly=ClientTools"
           xmlns:localPage="clr-namespace:UnicontaClient.Pages.CustomPage">
    <Grid x:Name="LayoutRoot" Background="{StaticResource LayoutGridColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <CorasauControls:CorasauRibbonControl x:Name="localMenu" XMLSourcePath=";component/Assets/EditableGridRibbon.xml" Grid.Row="0"/>
        <CorasauControls:BusyIndicator x:Name="busyIndicator" Grid.Row="1" BusyContent="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=LoadingMsg}">
            <localPage:DCGroupCurrencySummeryGrid x:Name="dgGrid" AutoGenerateColumns="None">
                <localPage:DCGroupCurrencySummeryGrid.Columns>
                    <localPage:ComboBoxColumnClient x:Name="Currency" />
                    <localPage:CorasauDataGridTemplateColumnClient x:Name="Account" />
                    <localPage:CorasauDataGridTemplateColumnClient x:Name="AccountName" />
                </localPage:DCGroupCurrencySummeryGrid.Columns>
            </localPage:DCGroupCurrencySummeryGrid>
        </CorasauControls:BusyIndicator>
    </Grid>
</Pages:GridBasePage>
