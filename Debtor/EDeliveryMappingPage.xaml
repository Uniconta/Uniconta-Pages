<Pages:GridBasePage xmlns:UC="clr-namespace:UnicontaClient.Pages;assembly=UnicontaPages"
x:Class="UnicontaClient.Pages.CustomPage.EDeliveryMappingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:CorasauControls="clr-namespace:Uniconta.ClientTools.Controls;assembly=ClientTools"
    xmlns:localPage="clr-namespace:UnicontaClient.Pages.CustomPage"
    xmlns:editor="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
    xmlns:Pages="clr-namespace:Uniconta.ClientTools.Page;assembly=ClientTools">
    <Pages:GridBasePage.Resources>
        <Style x:Key="MappingSourceCellStyle" TargetType="dxg:LightweightCellEditor"
            BasedOn="{StaticResource {dxgt:GridRowThemeKey ResourceKey=LightweightCellStyle}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding RowData.Row.RemoveTag}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MappingRemoveTagCellStyle" TargetType="dxg:LightweightCellEditor"
            BasedOn="{StaticResource {dxgt:GridRowThemeKey ResourceKey=LightweightCellStyle}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding RowData.Row.CanRemoveTag}" Value="False">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Pages:GridBasePage.Resources>
    <Grid x:Name="LayoutRoot" Background="{StaticResource LayoutGridColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <CorasauControls:CorasauRibbonControl x:Name="localMenu" XMLSourcePath=";component/Pages/Debtor/EDeliveryMappingRibbon.xml" />
        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="15" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="50" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="15" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=Group}" Grid.Column="0" />
            <CorasauControls:CorasauLayoutItem x:Name="liMappinggroup"
                Grid.Column="2"
                ButtonClicked="liMappinggroup_ButtonClicked"
                Style="{StaticResource LayoutItemsstyle}">
                <CorasauControls:LookupEditor x:Name="leMappinggroup"
                    SelectedIndexChanged="leMappinggroup_SelectedIndexChanged"
                    HorizontalContentAlignment="Right" />
                <CorasauControls:CorasauLayoutItem.ButtonContent>
                    <Image Source="{dx:SvgImageSource Uri=/UnicontaPages;component/Assets/img/Plus_8x8.svg,
                                                   UsePalette=True}"
                        Height="14"
                        dx:WpfSvgPalette.Palette="{StaticResource SVGIconPallete}" />
                </CorasauControls:CorasauLayoutItem.ButtonContent>
            </CorasauControls:CorasauLayoutItem>

            <TextBlock x:Name="tbDocumentNum"
                Grid.Column="4"
                Visibility="Collapsed" />
            <CorasauControls:LookupEditor x:Name="leDocumentNum"
                Grid.Column="6"
                Visibility="Collapsed"
                GotFocus="leDocumentNum_GotFocus" />
        </Grid>
        <GridSplitter Grid.Row="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="{StaticResource WindowHeaderGradient}" />
        <CorasauControls:BusyIndicator x:Name="busyIndicator"
            Grid.Row="3"
            BusyContent="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=LoadingMsg}">
            <localPage:EDeliveryMappingGrid x:Name="dgEdeliveryMappingGrid" AutoGenerateColumns="None">
                <localPage:EDeliveryMappingGrid.Columns>
                    <localPage:CorasauDataGridTemplateColumnClient x:Name="TagId" Width="270" AllowEditing="False" ReadOnly="True">
                        <localPage:CorasauDataGridTemplateColumnClient.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Margin="3,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                        Text="{Binding RowData.Row.DisplayFieldPath, Mode=OneWay}"
                                        ToolTip="{Binding RowData.Row.DisplayFieldPath}" />
                                    <Button x:Name="chooseOioUblField"
                                        Grid.Column="1" Margin="2,0" Padding="5,0"
                                        IsEnabled="{Binding RowData.Row.CanChooseField}"
                                        HorizontalContentAlignment="Left"
                                        Tag="{Binding RowData.Row}"
                                        ToolTip="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=eDeliveryChooseDocumentField}"
                                        Click="ChooseOioUblField_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Content" Value="..." />
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RowData.Row.TagId}" Value="0">
                                                        <Setter Property="Content" Value="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=eDeliveryChooseDocumentField}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RowData.Row.CanChooseField}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </localPage:CorasauDataGridTemplateColumnClient.CellTemplate>
                    </localPage:CorasauDataGridTemplateColumnClient>
                    <localPage:CorasauDataGridTemplateColumnClient x:Name="RemoveTag" Width="110" CellStyle="{StaticResource MappingRemoveTagCellStyle}"
                        ToolTip="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=eDeliveryRemoveTagHelp}" />
                    <localPage:CorasauDataGridTemplateColumnClient x:Name="TableId" Width="270" CellStyle="{StaticResource MappingSourceCellStyle}">
                        <localPage:CorasauDataGridTemplateColumnClient.EditSettings>
                            <CorasauControls:ComboBoxEditSettingsCustom x:Name="cmbTableIds"
                                DisplayMember="DisplayName"
                                ValueMember="Id" />
                        </localPage:CorasauDataGridTemplateColumnClient.EditSettings>
                    </localPage:CorasauDataGridTemplateColumnClient>
                    <localPage:CorasauDataGridTemplateColumnClient x:Name="Property" Width="100" CellStyle="{StaticResource MappingSourceCellStyle}">
                        <localPage:CorasauDataGridTemplateColumnClient.DisplayTemplate>
                            <ControlTemplate>
                                <TextBlock Margin="2"
                                    VerticalAlignment="Center"
                                    Text="{Binding DataContext.RowData.Row.Property, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                            </ControlTemplate>
                        </localPage:CorasauDataGridTemplateColumnClient.DisplayTemplate>
                        <localPage:CorasauDataGridTemplateColumnClient.CellTemplate>
                            <DataTemplate>
                                <CorasauControls:ComboBoxEditor x:Name="PART_Editor"
                                    GotFocus="PART_Editor_GotFocus"
                                    DisplayMember="DisplayName"
                                    ValueMember="Id"
                                    ItemsSource="{Binding DataContext.RowData.Row.PropertySource, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
                            </DataTemplate>
                        </localPage:CorasauDataGridTemplateColumnClient.CellTemplate>
                    </localPage:CorasauDataGridTemplateColumnClient>
                    <localPage:CorasauDataGridTemplateColumnClient x:Name="Value"
                        Width="150"
                        CellStyle="{StaticResource MappingSourceCellStyle}"
                        Visible="False" />
                    <localPage:CorasauDataGridTemplateColumnClient x:Name="FallbackDefaultValue" Width="190" CellStyle="{StaticResource MappingSourceCellStyle}"
                        ToolTip="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=eDeliveryFallbackDefaultValueHelp}" />
                </localPage:EDeliveryMappingGrid.Columns>
            </localPage:EDeliveryMappingGrid>
        </CorasauControls:BusyIndicator>
        <Grid x:Name="oioUblFieldPicker" Grid.Row="1" Grid.RowSpan="3"
            Panel.ZIndex="10" Background="#66000000" Visibility="Collapsed"
            KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="OioUblFieldPicker_PreviewKeyDown">
            <Border Width="980" MaxWidth="{Binding ActualWidth, ElementName=LayoutRoot}"
                Height="640" MaxHeight="{Binding ActualHeight, ElementName=oioUblFieldPicker}"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource LayoutGridColor}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="1" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=eDeliveryChooseDocumentField}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock x:Name="txtOioUblPickerDocument" Margin="0,5,0,12" />
                    </StackPanel>
                    <StackPanel Grid.Row="1">
                        <TextBlock Text="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=Path}" Margin="0,0,0,4" />
                        <Grid x:Name="oioUblGroupNavigation" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Content="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=Clear}" Padding="8,3" Margin="0,0,6,0" Click="OioUblGroupRoot_Click" />
                            <Button x:Name="btnOioUblGroupUp" Grid.Column="1" Content="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=Back}" Padding="8,3" Margin="0,0,6,0"
                                Click="OioUblGroupUp_Click" />
                            <TextBox x:Name="txtOioUblGroupPath" Grid.Column="2" Padding="6,4" IsReadOnly="True" />
                        </Grid>
                        <TextBlock Text="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=Search}" Margin="0,0,0,4" />
                        <TextBox x:Name="txtOioUblFieldSearch" Padding="6,4"
                            TextChanged="OioUblFieldSearch_TextChanged" />
                    </StackPanel>
                    <Grid Grid.Row="2" Margin="0,8,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="txtOioUblFieldCount" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button x:Name="btnRetryOioUblFields" Grid.Column="1" Content="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=Refresh}" Margin="8,0,0,0"
                            Padding="10,3" Visibility="Collapsed" Click="RetryOioUblFields_Click" />
                    </Grid>
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <ListBox x:Name="lstOioUblFields"
                            HorizontalContentAlignment="Stretch"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.CanContentScroll="True"
                            VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                            SelectionChanged="OioUblFields_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="5,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Path}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Margin="0,3,0,0" Text="{Binding Name}" Opacity="0.7" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=Open}" Tag="{Binding}" Padding="8,3" Margin="8,0,0,0"
                                            VerticalAlignment="Center" Click="OpenOioUblGroup_Click"
                                            ToolTip="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=eDeliveryFieldBrowseGroup}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsContainer}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border Grid.Column="2" Padding="10"
                            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Grid DataContext="{Binding SelectedItem, ElementName=lstOioUblFields}">
                                    <TextBlock Text="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=SelectDocumentField}" TextWrapping="Wrap" Opacity="0.7">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <StackPanel Margin="0,8,0,12">
                                            <TextBlock TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding Description}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                                                                <Setter Property="Text" Value="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=SchemaFieldNoDescription}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=eDeliveryFieldDescriptionLanguage}"
                                                Margin="0,4,0,0" FontSize="11" Opacity="0.65" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Description}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=Type}" FontWeight="SemiBold" />
                                        <TextBlock x:Name="txtOioUblFieldType" Margin="0,3,0,10" />
                                        <TextBlock FontWeight="SemiBold"
                                            ToolTip="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=eDeliveryFieldSchemaRequirementHelp}">
                                            <Run Text="{Binding Mode=OneWay, Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=Required}" /><Run Text=" / " /><Run Text="{Binding Mode=OneWay, Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=Optional}" />
                                        </TextBlock>
                                        <TextBlock x:Name="txtOioUblFieldRequirement" Margin="0,3,0,10" />
                                        <TextBlock Text="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=eDeliveryFieldRepetitions}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock x:Name="txtOioUblFieldRepetitions" Margin="0,3,0,12" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=eDeliveryFieldBrowseGroup}" Margin="0,0,0,8" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsContainer}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=eDeliveryFieldRecursiveGroup}" TextWrapping="Wrap" Opacity="0.7">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRecursive}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Content="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=Cancel}" MinWidth="80" Padding="10,5" Margin="0,0,8,0"
                            Click="CancelOioUblField_Click" />
                        <Button x:Name="btnUseOioUblField" Content="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=Select}" MinWidth="100"
                            Padding="10,5" IsEnabled="False" Click="UseOioUblField_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Pages:GridBasePage>
