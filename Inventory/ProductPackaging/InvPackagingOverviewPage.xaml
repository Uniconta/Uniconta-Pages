<Pages:GridBasePage xmlns:UC="clr-namespace:UnicontaClient.Pages;assembly=UnicontaPages"
x:Class="UnicontaClient.Pages.CustomPage.InvPackagingOverviewPage"
             xmlns:Pages="clr-namespace:Uniconta.ClientTools.Page;assembly=ClientTools"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UnicontaClient.Pages.CustomPage"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:CorasauControls="clr-namespace:Uniconta.ClientTools.Controls;assembly=ClientTools">
    <Grid x:Name="LayoutRoot" Background="{StaticResource LayoutGridColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <CorasauControls:CorasauRibbonControl XMLSourcePath=";component/Pages/Inventory/ProductPackaging/InvPackagingOverviewPageRibbon.xml" x:Name="localMenu"/>
        <CorasauControls:BusyIndicator x:Name="busyIndicator" Grid.Row="1" BusyContent="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=LoadingMsg}">
            <local:InvPackagingOverviewGrid x:Name="dgInvPackagingOverviewGrid" AutoGenerateColumns="None">
                <local:InvPackagingOverviewGrid.Columns>
                    <local:CorasauDataGridTemplateColumnClient x:Name="Item" Width="100" />
                    <local:CorasauDataGridTemplateColumnClient x:Name="ItemName" Width="200" />
                    <local:CorasauDataGridTemplateColumnClient x:Name="ReportingGroup" Width="150" />
                    <local:CorasauDataGridTemplateColumnClient x:Name="Source" Width="220" />
                    <local:CorasauDataGridTemplateColumnClient x:Name="Category" />
                    <local:CorasauDataGridTemplateColumnClient x:Name="PackagingType" />
                    <local:CorasauDataGridTemplateColumnClient x:Name="WasteSorting" />
                    <local:CorasauDataGridTemplateColumnClient x:Name="PackagingRateLevel" />
                    <local:CorasauDataGridTemplateColumnClient x:Name="PackagingConsumer" />
                    <local:CorasauDataGridTemplateColumnClient x:Name="Qty" Width="80" AllowThousandMask="True" Mask="#######0.########"/>
                    <local:CorasauDataGridTemplateColumnClient x:Name="Unit" Width="50" />
                    <local:CorasauDataGridTemplateColumnClient x:Name="PriceBusiness" AllowThousandMask="True"/>
                    <local:CorasauDataGridTemplateColumnClient x:Name="PriceTotalBusiness" AllowThousandMask="True"/>
                    <local:CorasauDataGridTemplateColumnClient x:Name="PriceHousehold" AllowThousandMask="True"/>
                    <local:CorasauDataGridTemplateColumnClient x:Name="PriceTotalHousehold" AllowThousandMask="True"/>
                    <local:CorasauDataGridTemplateColumnClient x:Name="Text" Width="200" />
                </local:InvPackagingOverviewGrid.Columns>
                <local:InvPackagingOverviewGrid.GroupSummary>
                    <local:SumColumn FieldName="Qty" SummaryType="Sum" DisplayFormat="{}{0:N4}"/>
                    <local:SumColumn FieldName="PriceTotalBusiness" SummaryType="Sum" DisplayFormat="{}{0:N2}"/>
                    <local:SumColumn FieldName="PriceTotalHousehold" SummaryType="Sum" DisplayFormat="{}{0:N2}"/>
                </local:InvPackagingOverviewGrid.GroupSummary>
                <local:InvPackagingOverviewGrid.TotalSummary>
                    <local:SumColumn FieldName="PriceTotalBusiness" SummaryType="Sum" DisplayFormat="{}{0:N2}"/>
                    <local:SumColumn FieldName="PriceTotalHousehold" SummaryType="Sum" DisplayFormat="{}{0:N2}"/>
                </local:InvPackagingOverviewGrid.TotalSummary>
            </local:InvPackagingOverviewGrid>
        </CorasauControls:BusyIndicator>
    </Grid>
</Pages:GridBasePage>
