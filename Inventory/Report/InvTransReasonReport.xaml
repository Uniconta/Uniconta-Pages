<Pages:GridBasePage xmlns:Pages="clr-namespace:Uniconta.ClientTools.Page;assembly=ClientTools" 
        xmlns:UC="clr-namespace:UnicontaClient.Pages;assembly=UnicontaPages"
x:Class="UnicontaClient.Pages.CustomPage.InvTransReasonReport"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UnicontaClient.Pages.CustomPage"
        xmlns:CorasauControls="clr-namespace:Uniconta.ClientTools.Controls;assembly=ClientTools">
    <UserControl.Resources>
        <DataTemplate x:Key="RegularCellTemplate">
            <Grid>
                <TextBlock FontWeight="Bold" Foreground="{StaticResource StatementAccountHeaderColorForeground}" VerticalAlignment="Center"  Text="{Binding RowData.Row.ItemNumber}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid x:Name="LayoutRoot" Background="{StaticResource LayoutGridColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <CorasauControls:CorasauRibbonControl x:Name="localMenu" XMLSourcePath=";component/Pages/Inventory/Report/InvTransReasonReportRibbon.xml"/>
        <CorasauControls:BusyIndicator x:Name="busyIndicator" Grid.Row="3" BusyContent="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=LoadingMsg}">
            <local:InvTransReasonGrid  x:Name="dgInvTransReason" AutoGenerateColumns="None">
                <local:InvTransReasonGrid.Columns>
                    <local:CorasauDataGridTemplateColumnClient x:Name="Date"/>
                    <local:CorasauDataGridTemplateColumnClient x:Name="FromDate"/>
                    <local:CorasauDataGridTemplateColumnClient x:Name="JournalPostedId"/>
                    <local:CorasauDataGridTemplateColumnClient x:Name="FromInvoice"/>
                    <local:CorasauDataGridTemplateColumnClient x:Name="Item"/>
                    <local:CorasauDataGridTemplateColumnClient x:Name="DCAccount"/>
                    <local:CorasauDataGridTemplateColumnClient x:Name="RecordType"/>
                    <local:CorasauDataGridTemplateColumnClient x:Name="ReturnReason"/>
                    <local:CorasauDataGridTemplateColumnClient x:Name="Comment"/>
                    <local:CorasauDataGridTemplateColumnClient x:Name="Reason"/>
                    <local:CorasauDataGridTemplateColumnClient x:Name="Qty"/>
                    <local:CorasauDataGridTemplateColumnClient x:Name="Scrap"/>
                    <local:CorasauDataGridTemplateColumnClient x:Name="LineNumber" Visible="False"/>
                </local:InvTransReasonGrid.Columns>
            </local:InvTransReasonGrid>
        </CorasauControls:BusyIndicator>

    </Grid>
</Pages:GridBasePage>
