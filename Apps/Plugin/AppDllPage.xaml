<Pages:GridBasePage   xmlns:Pages="clr-namespace:Uniconta.ClientTools.Page;assembly=ClientTools" 
         xmlns:UC="clr-namespace:UnicontaClient.Pages;assembly=UnicontaPages"
x:Class="UnicontaClient.Pages.CustomPage.AppDLLPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UnicontaClient.Pages.CustomPage" 
        xmlns:ClientTools="clr-namespace:Uniconta.ClientTools;assembly=ClientTools"
        xmlns:UnicontaControls="clr-namespace:Uniconta.ClientTools.Controls;assembly=ClientTools" >
    <Grid x:Name="LayoutRoot" Background="{StaticResource LayoutGridColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <UnicontaControls:CorasauRibbonControl x:Name="localMenu" XMLSourcePath=";component/Pages/Apps/Plugin/AppDLLPageRibbon.xml" Grid.Row="0"/>
        <UnicontaControls:BusyIndicator x:Name="busyIndicator" Grid.Row="1" BusyContent="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=LoadingMsg}">
            <local:AppDLLGridClient  x:Name="dgAppDLLGrid" AutoGenerateColumns="None">
                <local:AppDLLGridClient.Columns>
                    <local:CorasauDataGridTemplateColumnClient x:Name="PrimaryKeyId" Width="90" />
                    <local:CorasauDataGridTemplateColumnClient x:Name="Pid" Width="90" />
                    <local:CorasauDataGridTemplateColumnClient x:Name="Name" MinWidth="200" />
                    <local:CorasauDataGridTemplateColumnClient x:Name="VersionDLL1" />
                    <local:CorasauDataGridTemplateColumnClient x:Name="VersionDLL2" />
                    <local:CorasauDataGridTemplateColumnClient x:Name="Updated" MinWidth="100" ShowTime="True"  />
                    <local:CorasauDataGridTemplateColumnClient x:Name="Disable" MinWidth="60" />
                    <local:CorasauDataGridTemplateColumnClient x:Name="Comment" MinWidth="500" />
                </local:AppDLLGridClient.Columns> 
            </local:AppDLLGridClient>

        </UnicontaControls:BusyIndicator>

    </Grid>
</Pages:GridBasePage>
