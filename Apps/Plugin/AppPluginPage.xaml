<Pages:GridBasePage xmlns:Pages="clr-namespace:Uniconta.ClientTools.Page;assembly=ClientTools"  
        xmlns:UC="clr-namespace:UnicontaClient.Pages;assembly=UnicontaPages"
x:Class="UnicontaClient.Pages.CustomPage.AppPluginPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UnicontaClient.Pages.CustomPage"
        xmlns:UnicontaControls="clr-namespace:Uniconta.ClientTools.Controls;assembly=ClientTools"
        mc:Ignorable="d" d:DesignHeight="300" d:DesignWidth="400">
     <Grid x:Name="LayoutRoot" Background="{StaticResource LayoutGridColor}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <UnicontaControls:CorasauRibbonControl XMLSourcePath=";component/Pages/Apps/Plugin/AppPluginRibbon.xml" x:Name="localMenu"/>
        <UnicontaControls:BusyIndicator x:Name="busyIndicator" Grid.Row="1" BusyContent="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=LoadingMsg}">
            <local:AppPluginGrid  x:Name="dgAppPluginGrid" AutoGenerateColumns="None">
                <local:AppPluginGrid.Columns>
                    <local:CorasauDataGridTemplateColumnClient x:Name="Name" Width="150"/>
                    <local:CorasauDataGridTemplateColumnClient x:Name="Control" Width="200"/>
                    <local:CorasauDataGridTemplateColumnClient x:Name="HasPartner" Width="50" />
                    <local:CorasauDataGridTemplateColumnClient x:Name="PartnerDLLRowId" Width="50" />
                    <local:CorasauDataGridTemplateColumnClient x:Name="Dll" Width="150"/>
                    <local:CorasauDataGridTemplateColumnClient x:Name="Disable" Width="50"/>
                    <local:CorasauDataGridTemplateColumnClient x:Name="ForCompanyId" Width="70" />
                    <local:CorasauDataGridTemplateColumnClient x:Name="Userid" Width="50" />
                    <local:CorasauDataGridTemplateColumnClient x:Name="PluginType" Width="100" />
                    <local:CorasauDataGridTemplateColumnClient x:Name="CanDisable" />
                    <local:CorasauDataGridTemplateColumnClient x:Name="Prompt" Width="200"/>
                    <local:CorasauDataGridTemplateColumnClient x:Name="ClassName" Width="100"/>
                    <local:CorasauDataGridTemplateColumnClient x:Name="Command" Width="100"/>
                    <local:CorasauDataGridTemplateColumnClient x:Name="Argument" Width="100"/>
                    <local:CorasauDataGridTemplateColumnClient x:Name="Comment" Width="300"/>
                 </local:AppPluginGrid.Columns>
            </local:AppPluginGrid>
        </UnicontaControls:BusyIndicator>
    </Grid>
</Pages:GridBasePage>
