<Pages:GridBasePage xmlns:UC="clr-namespace:UnicontaClient.Pages;assembly=UnicontaPages"
x:Class="UnicontaClient.Pages.CustomPage.AppReportsPage"
      xmlns:Pages="clr-namespace:Uniconta.ClientTools.Page;assembly=ClientTools"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:UnicontaClient.Pages.CustomPage"
      xmlns:CorasauControls="clr-namespace:Uniconta.ClientTools.Controls;assembly=ClientTools"
      xmlns:ClientTools="clr-namespace:Uniconta.ClientTools;assembly=ClientTools"
      xmlns:editor="http://schemas.devexpress.com/winfx/2008/xaml/editors">

    <CorasauControls:BusyIndicator x:Name="busyIndicator" Grid.Row="0" BusyContent="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=BusyMessage}">
        <Grid x:Name="LayoutRoot" Background="{StaticResource LayoutGridColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="30" />
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <CorasauControls:CorasauRibbonControl x:Name="localMenu" XMLSourcePath=";component/Pages/Apps/Reports/AppReportsPageRibbon.xml"/>
            <StackPanel Orientation="Horizontal" Grid.Row="1">
                <TextBlock Text="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=Reports,StringFormat=\{0\}:}" VerticalAlignment="Center"></TextBlock>
                <ComboBox x:Name="cmbReports" Margin="10 0 0 0" SelectionChanged="cmbReports_SelectionChanged" DisplayMemberPath="ReportLocalizedName" Height="23" Width="200" HorizontalAlignment="Left"></ComboBox>
            </StackPanel>
            <local:AppUserReportDevExpressGrid x:Name="dgUserReportDevX" Grid.Row="2" AutoGenerateColumns="None">
                <local:AppUserReportDevExpressGrid.Columns>
                    <local:CorasauDataGridTemplateColumnClient x:Name="Name" />
                    <local:CorasauDataGridTemplateColumnClient x:Name="Comment" MinWidth="400" />
                    <local:CorasauDataGridTemplateColumnClient x:Name="Uid" Width="55" />
                    <local:CorasauDataGridTemplateColumnClient x:Name="colUpdatedAt" FieldName="UpdatedAt" IsSmart="True" >
                        <local:CorasauDataGridTemplateColumnClient.EditSettings>
                            <editor:TextEditSettings DisplayFormat="g" MaskType="DateTime" />
                        </local:CorasauDataGridTemplateColumnClient.EditSettings>
                    </local:CorasauDataGridTemplateColumnClient>
                    <local:CorasauDataGridTemplateColumnClient x:Name="OpenForEdit" Width="85"/>
                    <local:CorasauDataGridTemplateColumnClient x:Name="AllUsers" Width="85" />
                    <local:CorasauDataGridTemplateColumnClient x:Name="AllCompanies" Width="85" />
                    <local:CorasauDataGridTemplateColumnClient x:Name="ForCompanyId" Width="85" />
                    <local:CorasauDataGridTemplateColumnClient x:Name="ForSubId" Width="85" />
                    <local:CorasauDataGridTemplateColumnClient x:Name="CustomSource" Width="85" />
                </local:AppUserReportDevExpressGrid.Columns>
            </local:AppUserReportDevExpressGrid>
        </Grid>
    </CorasauControls:BusyIndicator>
</Pages:GridBasePage>
