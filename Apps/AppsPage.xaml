<Pages:GridBasePage xmlns:UC="clr-namespace:UnicontaClient.Pages;assembly=UnicontaPages"
x:Class="UnicontaClient.Pages.CustomPage.AppsPage"
           xmlns:Pages="clr-namespace:Uniconta.ClientTools.Page;assembly=ClientTools"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:ClientTools="clr-namespace:Uniconta.ClientTools;assembly=ClientTools"
           xmlns:CorasauControls="clr-namespace:Uniconta.ClientTools.Controls;assembly=ClientTools"
           xmlns:localPage="clr-namespace:UnicontaClient.Pages.CustomPage">
    <Grid x:Name="LayoutRoot" Background="{StaticResource LayoutGridColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <CorasauControls:CorasauRibbonControl x:Name="localMenu" XMLSourcePath=";component/Pages/Apps/AppsPageGridRibbon.xml" Grid.Row="0"/>
        <CorasauControls:BusyIndicator x:Name="busyIndicator" Grid.Row="1"
                                       BusyContent="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=LoadingMsg}">
            <localPage:AppsGrid x:Name="dgGrid" AutoGenerateColumns="None">
                <localPage:AppsGrid.Columns>
                    <localPage:CorasauDataGridTemplateColumnClient x:Name="AppId" Width="80"/>
                    <localPage:CorasauDataGridTemplateColumnClient x:Name="Name" Width="200"/>
                    <localPage:CorasauDataGridTemplateColumnClient x:Name="Comment" Width="200"/>
                    <localPage:CorasauDataGridTemplateColumnClient x:Name="URL" AllowEditing="False" Width="200">
                        <localPage:CorasauDataGridTemplateColumnClient.DisplayTemplate>
                            <ControlTemplate>
                                <TextBlock Margin="2"
                                           VerticalAlignment="Center"
                                           Text="{Binding Value}"
                                           TextDecorations="Underline"
                                           Cursor="Hand"
                                           PreviewMouseDown="URL_PreviewMouseDown"/>
                            </ControlTemplate>
                        </localPage:CorasauDataGridTemplateColumnClient.DisplayTemplate>
                    </localPage:CorasauDataGridTemplateColumnClient>
                    <localPage:CorasauDataGridTemplateColumnClient x:Name="MainVersion" Visible="False"/>
                    <localPage:CorasauDataGridTemplateColumnClient x:Name="MinorVersion" Visible="False"/>
                    <localPage:CorasauDataGridTemplateColumnClient x:Name="Uid" Width="80"/>
                    <localPage:CorasauDataGridTemplateColumnClient x:Name="Pid" Width="80"/>
                    <localPage:CorasauDataGridTemplateColumnClient x:Name="Open"/>
                    <localPage:CorasauDataGridTemplateColumnClient x:Name="InTest"/>
                    <localPage:CorasauDataGridTemplateColumnClient x:Name="Blocked"/>
                    <localPage:CorasauDataGridTemplateColumnClient x:Name="Free"/>
                    <localPage:CorasauDataGridTemplateColumnClient x:Name="OnlyOwnCustomers"/>
                    <localPage:CorasauDataGridTemplateColumnClient x:Name="FromAppId"/>
                    <localPage:CorasauDataGridTemplateColumnClient x:Name="NetFramework"/>
                    <localPage:CorasauDataGridTemplateColumnClient x:Name="NetCore"/>
                </localPage:AppsGrid.Columns>
            </localPage:AppsGrid>
        </CorasauControls:BusyIndicator>
    </Grid>
</Pages:GridBasePage>
