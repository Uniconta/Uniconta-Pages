<Pages:FormBasePage xmlns:UC="clr-namespace:UnicontaClient.Pages;assembly=UnicontaPages"
x:Class="UnicontaClient.Pages.CustomPage.GL.TransactionOrigin.GLPostingSourceTrace"
                    xmlns:Pages="clr-namespace:Uniconta.ClientTools.Page;assembly=ClientTools" 
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:localPage="clr-namespace:UnicontaClient.Pages.CustomPage"
                    xmlns:CorasauControls="clr-namespace:Uniconta.ClientTools.Controls;assembly=ClientTools"
                    xmlns:visuals="clr-namespace:UnicontaClient.Pages.CustomPage.GL.TransactionOrigin.Visuals"
                    xmlns:local="clr-namespace:UnicontaClient.Pages.CustomPage.GL.TransactionOrigin">
    <Grid x:Name="LayoutRoot"
          MinHeight="480"
          MinWidth="640"
          VerticalAlignment="Stretch"
          HorizontalAlignment="Stretch"
          Background="{StaticResource LayoutGridColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <CorasauControls:CorasauRibbonControl x:Name="frmRibbon"
                                              Grid.Row="0"
                                              Visibility="Collapsed"
                                              XMLSourcePath=";component/Pages/GL/TransactionOrigin/GLPostingSourceTraceRibbon.xml" />

        <CorasauControls:BusyIndicator x:Name="busyIndicator"
                                       Grid.Row="1"
                                       BusyContent="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=LoadingMsg}">
            <CorasauControls:CorasauLayoutControl x:Name="layoutItems" Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch">

                <TabControl>
                    <TabItem Header="{Binding Converter={StaticResource GlobalLocalizationValueConverter},
                          ConverterParameter=Diagram}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <CorasauControls:CorasauLayoutControl Grid.Row="0" Orientation="Horizontal" Margin="8">
                                <CorasauControls:CorasauLayoutItem Label="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=VoucherTransactions}">
                                    <CorasauControls:ComboBoxEditor
                                        x:Name="transactionSelector"
                                        IsTextEditable="False"
                                        MinWidth="420"
                                        VerticalAlignment="Center"
                                        SelectedIndexChanged="TransactionSelector_SelectedIndexChanged" />
                                </CorasauControls:CorasauLayoutItem>
                                <CorasauControls:CorasauLayoutItem Label="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=Invoice}">
                                <CorasauControls:ComboBoxEditor x:Name="invoiceSelector"
                                        IsTextEditable="False"
                                        MinWidth="180"
                                        VerticalAlignment="Center"
                                        SelectedIndexChanged="InvoiceSelector_SelectedIndexChanged" />
                                </CorasauControls:CorasauLayoutItem>
                                <CorasauControls:CorasauLayoutItem Label="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=Order}">
                                <CorasauControls:ComboBoxEditor x:Name="transactionSortSelector"
                                        IsTextEditable="False"
                                        MinWidth="180"
                                        VerticalAlignment="Center"
                                        SelectedIndexChanged="TransactionSortSelector_SelectedIndexChanged" />
                                </CorasauControls:CorasauLayoutItem>
                            </CorasauControls:CorasauLayoutControl>
                            <visuals:PostingTraceDiagramView x:Name="visualizer" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Grid>
                    </TabItem>
                    <TabItem Header="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=GLTraceMatchData}">
                        <local:PostingTraceMatchGrid x:Name="matchDataGrid"
                                                     ItemsSource="{Binding DataContext.MatchRows, ElementName=visualizer}"
                                                     AutoGenerateColumns="None">
                            <local:PostingTraceMatchGrid.Columns>
                                <localPage:CorasauDataGridTemplateColumnClient FieldName="Voucher" Header="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=Voucher}" Width="90" AllowEditing="False" />
                                <localPage:CorasauDataGridTemplateColumnClient FieldName="VoucherLine" Header="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=GLTraceVoucherLine}" Width="90" AllowEditing="False" />
                                <localPage:CorasauDataGridTemplateColumnClient FieldName="Date" Header="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=Date}" Width="100" AllowEditing="False" />
                                <localPage:CorasauDataGridTemplateColumnClient FieldName="TransactionAccount" Header="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=GLTraceTransactionAccount}" Width="130" AllowEditing="False" />
                                <localPage:CorasauDataGridTemplateColumnClient FieldName="TransactionAccountName" Header="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=GLTraceTransactionAccountName}" Width="180" AllowEditing="False" />
                                <localPage:CorasauDataGridTemplateColumnClient FieldName="TransactionText" Header="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=TransactionText}" Width="180" AllowEditing="False" />
                                <localPage:CorasauDataGridTemplateColumnClient FieldName="TransactionAmount" Header="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=GLTraceTransactionAmount}" Width="120" AllowEditing="False" />
                                <localPage:CorasauDataGridTemplateColumnClient FieldName="IsManual" Header="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=Manual}" Width="90" AllowEditing="False" />
                                <localPage:CorasauDataGridTemplateColumnClient FieldName="Explanation" Header="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=GLTraceExplanation}" Width="260" AllowEditing="False" />
                                <localPage:CorasauDataGridTemplateColumnClient FieldName="MatchingAccount" Header="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=GLTraceMatchingAccount}" Width="130" AllowEditing="False" />
                                <localPage:CorasauDataGridTemplateColumnClient FieldName="AccountName" Header="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=AccountName}" Width="180" AllowEditing="False" />
                                <localPage:CorasauDataGridTemplateColumnClient FieldName="AccountType" Header="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=PostAccountType}" Width="120" AllowEditing="False" />
                                <localPage:CorasauDataGridTemplateColumnClient FieldName="Area" Header="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=Area}" Width="120" AllowEditing="False" />
                                <localPage:CorasauDataGridTemplateColumnClient FieldName="Reason" Header="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=Reason}" Width="180" AllowEditing="False" />
                                <localPage:CorasauDataGridTemplateColumnClient FieldName="Confidence" Header="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=GLTraceConfidence}" Width="120" AllowEditing="False" />
                                <localPage:CorasauDataGridTemplateColumnClient FieldName="SourceTable" Header="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=GLTraceSourceTable}" Width="160" AllowEditing="False" />
                                <localPage:CorasauDataGridTemplateColumnClient FieldName="SourceTableKey" Header="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=GLTraceSourceKey}" Width="160" AllowEditing="False" />
                                <localPage:CorasauDataGridTemplateColumnClient FieldName="SourceField" Header="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=GLTraceSourceField}" Width="160" AllowEditing="False" />
                            </local:PostingTraceMatchGrid.Columns>
                        </local:PostingTraceMatchGrid>
                    </TabItem>
                    <TabItem Header="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=SourceList}">
                        <Grid Background="{DynamicResource LightBackground}">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto">
                                <TreeView ItemsSource="{Binding DataContext.DebugItems, ElementName=visualizer}"
                                          Margin="8">
                                    <TreeView.Resources>
                                        <HierarchicalDataTemplate DataType="{x:Type visuals:PostingTraceTreeItemViewModel}"
                                                                  ItemsSource="{Binding Children}">
                                            <Border Padding="6"
                                                    Margin="0,2,0,2"
                                                    BorderThickness="0,0,0,1"
                                                    BorderBrush="{DynamicResource LightBackgroundComponentBorder}"
                                                    ToolTip="{Binding ToolTipText}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="260" />
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Account}" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Detail}" Opacity="0.75" TextWrapping="Wrap" />
                                                </Grid>
                                            </Border>
                                        </HierarchicalDataTemplate>
                                    </TreeView.Resources>
                                    <TreeView.ItemContainerStyle>
                                        <Style TargetType="{x:Type TreeViewItem}">
                                            <Setter Property="IsExpanded" Value="True" />
                                        </Style>
                                    </TreeView.ItemContainerStyle>
                                </TreeView>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                </TabControl>
            </CorasauControls:CorasauLayoutControl>
        </CorasauControls:BusyIndicator>
    </Grid>
</Pages:FormBasePage>
