<UserControl xmlns:UC="clr-namespace:UnicontaClient.Pages;assembly=UnicontaPages"
x:Class="UnicontaClient.Pages.CustomPage.GL.TransactionOrigin.Visuals.TransactionDiagramNodeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vis="clr-namespace:UnicontaClient.Pages.CustomPage.GL.TransactionOrigin.Visuals"
             Width="{Binding Width}"
             Height="{Binding Height}"
             Foreground="{StaticResource PostingTraceForegroundBrush}">

    <UserControl.Resources>
        <vis:NodeKindToColorConverter x:Key="NodeKindToColorConverter" />
        <vis:ConfidenceToBrushConverter x:Key="ConfidenceToBrushConverter" />

    </UserControl.Resources>

    <Grid>

        <!-- Accent shadow -->
        <Border Margin="5,0,0,6"
                Background="{StaticResource PostingTraceCardBackgroundBrush}"
                CornerRadius="18"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect Color="{Binding Kind, Converter={StaticResource NodeKindToColorConverter}}"
                                  ShadowDepth="8"
                                  BlurRadius="10"
                                  Direction="225"
                                  Opacity="0.45" />
            </Border.Effect>
        </Border>

        <!-- Main card -->
        <Border Margin="5,0,0,6"
                Background="{StaticResource PostingTraceCardBackgroundBrush}"
                BorderBrush="{StaticResource PostingTraceCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="22,18,20,16"
                ToolTip="{Binding ToolTipText}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Button Grid.Row="0"
                        Margin="0,4,0,0"
                        Padding="0"
                        HorizontalAlignment="Left"
                        Background="{StaticResource PostingTraceTransparentBrush}"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Account_Click">

                    <TextBlock Text="{Binding AccountText}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                               TextWrapping="Wrap"
                               TextDecorations="{x:Null}" />
                </Button>

                <Grid Grid.Row="1"
                      Grid.RowSpan="4"
                      Margin="0,8,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="&#xE77B;"
                               FontFamily="Segoe MDL2 Assets"
                               Opacity="0.7"
                               Visibility="{Binding SystemAccountTextVisibility}" />

                    <TextBlock Grid.Row="0"
                               Grid.Column="1"
                               Margin="0,0,5,4"
                               Text="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=SystemAccount}"
                               Opacity="0.8"
                               Visibility="{Binding SystemAccountTextVisibility}" />

                    <TextBlock Grid.Row="0"
                               Grid.Column="2"
                               Margin="0,0,0,4"
                               Text="{Binding SystemAccountText}"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               Visibility="{Binding SystemAccountTextVisibility}" />

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="&#xE713;"
                               FontFamily="Segoe MDL2 Assets"
                               Opacity="0.7"
                               Visibility="{Binding OriginTextVisibility}" />

                    <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               Margin="0,0,5,4"
                               Text="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=Origin}"
                               Opacity="0.8"
                               Visibility="{Binding OriginTextVisibility}" />

                    <TextBlock Grid.Row="1"
                               Grid.Column="2"
                               Margin="0,0,0,4"
                               Text="{Binding OriginText}"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               Visibility="{Binding OriginTextVisibility}" />

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="&#xE787;"
                               FontFamily="Segoe MDL2 Assets"
                               Opacity="0.7" />

                    <TextBlock Grid.Row="2"
                               Grid.Column="1"
                               Margin="0,0,5,4"
                               Text="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=PostingDate}"
                               Opacity="0.8" />

                    <TextBlock Grid.Row="2"
                               Grid.Column="2"
                               Margin="0,0,0,4"
                               Text="{Binding BookedDateText}"
                               FontWeight="Bold"
                               TextWrapping="Wrap" />

                    <TextBlock Grid.Row="3"
                               Grid.Column="0"
                               Text="&#xE8C7;"
                               FontFamily="Segoe MDL2 Assets"
                               Opacity="0.7" />

                    <TextBlock Grid.Row="3"
                               Grid.Column="1"
                               Margin="0,0,5,0"
                               Text="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=Amount}"
                               Opacity="0.8" />

                    <TextBlock Grid.Row="3"
                               Grid.Column="2"
                               Text="{Binding AmountText}"
                               FontWeight="Bold"
                               TextWrapping="Wrap" />

                </Grid>

                <StackPanel Grid.Row="5"
                            Margin="0,10,0,0">

                    <Border Height="1"
                            Background="{StaticResource PostingTraceCardBorderBrush}"
                            Margin="0,0,0,8" />

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="&#xE8A5;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="12"
                                   Margin="0,0,7,0"
                                   Opacity="0.7" />

                        <TextBlock Text="{Binding Detail}"
                                   FontSize="11"
                                   Opacity="0.75"
                                   TextWrapping="Wrap" />

                    </StackPanel>
                </StackPanel>

            </Grid>
        </Border>

        <vis:MoveThumb Style="{StaticResource PostingTraceMoveThumbStyle}" />
        <vis:ResizeThumb Style="{StaticResource PostingTraceResizeThumbStyle}" />

    </Grid>
</UserControl>
