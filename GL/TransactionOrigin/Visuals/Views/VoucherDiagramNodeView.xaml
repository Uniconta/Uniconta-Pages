<UserControl xmlns:UC="clr-namespace:UnicontaClient.Pages;assembly=UnicontaPages"
x:Class="UnicontaClient.Pages.CustomPage.GL.TransactionOrigin.Visuals.VoucherDiagramNodeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vis="clr-namespace:UnicontaClient.Pages.CustomPage.GL.TransactionOrigin.Visuals"
             Width="{Binding Width}"
             Height="{Binding Height}"
             Foreground="{StaticResource PostingTraceForegroundBrush}">

    <UserControl.Resources>
        <vis:NodeKindToColorConverter x:Key="NodeKindToColorConverter" />
        <vis:ConfidenceToBrushConverter x:Key="ConfidenceToBrushConverter" />
    </UserControl.Resources>

    <Grid>

        <!-- Accent shadow -->
        <Border Margin="5,0,0,6"
                Background="{StaticResource PostingTraceCardBackgroundBrush}"
                CornerRadius="18"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect
                    Color="{Binding Kind, Converter={StaticResource NodeKindToColorConverter}}"
                    ShadowDepth="8"
                    BlurRadius="10"
                    Direction="225"
                    Opacity="0.45" />
            </Border.Effect>
        </Border>

        <!-- Main card -->
        <Border Margin="5,0,0,6"
                Background="{StaticResource PostingTraceCardBackgroundBrush}"
                BorderBrush="{StaticResource PostingTraceCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="22,18,20,16"
                ToolTip="{Binding ToolTipText}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Title -->
                <TextBlock Grid.Row="0"
                           Text="{Binding Title}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />

                <!-- Clickable related account -->
                <Button Grid.Row="1"
                        Margin="0,8,0,0"
                        Padding="0"
                        HorizontalAlignment="Left"
                        Background="{StaticResource PostingTraceTransparentBrush}"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="DCAccountInfo_Click">

                    <TextBlock Text="{Binding DCAccountInfo}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextDecorations="{x:Null}" />
                </Button>

                <!-- Footer/detail -->
                <StackPanel Grid.Row="2"
                            Margin="0,12,0,0">

                    <Border Height="1"
                            Background="{StaticResource PostingTraceCardBorderBrush}"
                            Margin="0,0,0,8" />

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="&#xE8A5;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="12"
                                   Margin="0,0,7,0"
                                   Opacity="0.7"
                                   VerticalAlignment="Top" />

                        <TextBlock Text="{Binding PostingCountText}"
                                   FontSize="11"
                                   Opacity="0.75"
                                   TextWrapping="Wrap" />

                    </StackPanel>

                </StackPanel>

            </Grid>
        </Border>
        <vis:MoveThumb Style="{StaticResource PostingTraceMoveThumbStyle}" />
        <vis:ResizeThumb Style="{StaticResource PostingTraceResizeThumbStyle}" />
    </Grid>
</UserControl>