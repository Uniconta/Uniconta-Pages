<UserControl xmlns:UC="clr-namespace:UnicontaClient.Pages;assembly=UnicontaPages"
x:Class="UnicontaClient.Pages.CustomPage.GL.TransactionOrigin.Visuals.PostingTraceDiagramNodeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vis="clr-namespace:UnicontaClient.Pages.CustomPage.GL.TransactionOrigin.Visuals"
             Width="{Binding Width}"
             Height="{Binding Height}"
             Foreground="{StaticResource PostingTraceForegroundBrush}">

    <UserControl.Resources>
        <vis:NodeKindToColorConverter x:Key="NodeKindToColorConverter" />
        <vis:ConfidenceToBrushConverter x:Key="ConfidenceToBrushConverter" />

    </UserControl.Resources>

    <Grid>
        <!-- Accent shadow -->
        <Border Margin="5,0,0,6"
                Background="{StaticResource PostingTraceCardBackgroundBrush}"
                CornerRadius="18"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect Color="{Binding Kind, Converter={StaticResource NodeKindToColorConverter}}"
                                  ShadowDepth="8"
                                  BlurRadius="10"
                                  Direction="225"
                                  Opacity="0.45" />
            </Border.Effect>
        </Border>

        <vis:MoveThumb Cursor="{Binding CardCursor}" Background="{StaticResource PostingTraceTransparentBrush}" />

        <Border Margin="5,0,0,6"
                Background="{StaticResource PostingTraceCardBackgroundBrush}"
                BorderBrush="{StaticResource PostingTraceCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="22,18,20,16"
                ToolTip="{Binding ToolTipText}"
                IsHitTestVisible="False">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{Binding Title}"
                           FontWeight="SemiBold"
                           FontSize="16"
                           TextWrapping="Wrap" />

                <TextBlock Grid.Row="1"
                           Text="{Binding Subtitle}"
                           Margin="0,4,0,0"
                           FontSize="12"
                           Opacity="0.8"
                           TextWrapping="Wrap" />

                <TextBlock Grid.Row="2"
                           Text="{Binding Detail}"
                           Margin="0,8,0,0"
                           FontSize="11"
                           Opacity="0.75"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- Resize grip stays above drag surface -->
        <vis:ResizeThumb Style="{StaticResource PostingTraceResizeThumbStyle}" />
    </Grid>
</UserControl>
