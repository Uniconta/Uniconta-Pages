<Pages:GridBasePage xmlns:Pages="clr-namespace:Uniconta.ClientTools.Page;assembly=ClientTools"
   xmlns:UC="clr-namespace:UnicontaClient.Pages;assembly=UnicontaPages"
x:Class="UnicontaClient.Pages.CustomPage.GLAccountWhereUsedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:localPage="clr-namespace:UnicontaClient.Pages.CustomPage"                    
    xmlns:CorasauControls="clr-namespace:Uniconta.ClientTools.Controls;assembly=ClientTools">
    <Grid x:Name="LayoutRoot" Background="{StaticResource LayoutGridColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <CorasauControls:CorasauRibbonControl x:Name="localMenu" XMLSourcePath=";component/Assets/FormRibbonNoLayout.xml" Grid.Row="0"/>
        <CorasauControls:BusyIndicator x:Name="busyIndicator" Grid.Row="1" BusyContent="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=LoadingMsg}">
            <localPage:GLAccountWhereUsedGrid  x:Name="dgResults" AutoGenerateColumns="None">
                <localPage:GLAccountWhereUsedGrid.Columns>
                    <localPage:CorasauDataGridTemplateColumnClient x:Name="SourceTableName" Header="Table" Width="160" AllowEditing="False"/>
                    <localPage:CorasauDataGridTemplateColumnClient x:Name="SourceTableKey" Header="Key" Width="180" AllowEditing="False">
                        <localPage:CorasauDataGridTemplateColumnClient.DisplayTemplate>
                            <ControlTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Margin="5,0,0,0" TextDecorations="Underline" Cursor="Hand" VerticalAlignment="Center" Text="{Binding Value}" PreviewMouseDown="SourceTableKey_PreviewMouseDown"/>
                                    <TextBlock Grid.Column="1"/>
                                </Grid>
                            </ControlTemplate>
                        </localPage:CorasauDataGridTemplateColumnClient.DisplayTemplate>
                    </localPage:CorasauDataGridTemplateColumnClient>
                    <localPage:CorasauDataGridTemplateColumnClient x:Name="SourceField" Header="Field" Width="140" AllowEditing="False"/>
                    <localPage:CorasauDataGridTemplateColumnClient x:Name="SourceFieldDescription" Header="Field description" Width="220" AllowEditing="False"/>
                    <localPage:CorasauDataGridTemplateColumnClient x:Name="SourceValue" Header="Value" Width="100" AllowEditing="False"/>
                    <localPage:CorasauDataGridTemplateColumnClient x:Name="Description" Header="Description" Width="220" AllowEditing="False"/>
                </localPage:GLAccountWhereUsedGrid.Columns>
            </localPage:GLAccountWhereUsedGrid>
        </CorasauControls:BusyIndicator>
    </Grid>
</Pages:GridBasePage>
