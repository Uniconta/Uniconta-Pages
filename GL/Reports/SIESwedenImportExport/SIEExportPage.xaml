<Pages:GridBasePage xmlns:UC="clr-namespace:UnicontaClient.Pages.CustomPage;assembly=UnicontaPages"
            xmlns:UC="clr-namespace:UnicontaClient.Pages;assembly=UnicontaPages"
x:Class="UnicontaClient.Pages.CustomPage.SIEExportPage"
            xmlns:Pages="clr-namespace:Uniconta.ClientTools.Page;assembly=ClientTools"  
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:CorasauControls="clr-namespace:Uniconta.ClientTools.Controls;assembly=ClientTools"
            xmlns:localPage="clr-namespace:UnicontaClient.Pages.CustomPage"
            xmlns:ClientToolsControls="clr-namespace:Uniconta.ClientTools.Controls;assembly=ClientTools"
            xmlns:editorSettings="http://schemas.devexpress.com/winfx/2008/xaml/editors">
    <Grid>
        <Grid x:Name="LayoutRoot" Background="{StaticResource LayoutGridColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="10"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            <CorasauControls:CorasauRibbonControl x:Name="localMenu" XMLSourcePath=";component/Pages/GL/Reports/SIESwedenImportExport/SIEExportPageRibbon.xml"/>
            <Grid Grid.Row="1" Margin="5" x:Name="gridHeaderParam">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="15" />
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=FromDate}" Grid.Column="0" Grid.Row="0" Margin="3,3,3,3"/>
                <CorasauControls:DateEditor x:Name="deDateFrm" Grid.Column="2" Grid.Row="0" Margin="0,3,3,3"/>
                <TextBlock Text="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=ToDate}" Grid.Column="4" Grid.Row="0" Margin="3,3,3,3"/>
                <CorasauControls:DateEditor x:Name="deDateTo" Grid.Column="6" Grid.Row="0" Margin="0,3,3,3"/>
                <TextBlock Text="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=Type}" Grid.Column="8" Grid.Row="0" Margin="3,3,3,3"/>
                <ClientToolsControls:ComboBoxEditor x:Name="cbSIEFormatType" MinWidth="80" Grid.Column="10" Grid.Row="0" Margin="0,3,3,3"/>
                <TextBlock Text="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=SIECompanyType}" Grid.Column="12" Grid.Row="0" Margin="3,3,3,3"/>
                <ClientToolsControls:ComboBoxEditor x:Name="cbSIECompanyType" ValueMember="Key" DisplayMember="Value" MinWidth="80" Grid.Column="14" Grid.Row="0" Margin="0,3,3,3"/>
                <TextBlock Text="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=Budget}" Grid.Column="16" Grid.Row="0" Margin="3,3,3,3"/>
                <ClientToolsControls:ComboBoxEditor x:Name="cbBudget" IsEditable="False" MinWidth="80" Grid.Column="18" Grid.Row="0" Margin="0,3,3,3"/>
            </Grid>
            <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{StaticResource WindowHeaderGradient}" />
            <CorasauControls:BusyIndicator x:Name="busyIndicator" Grid.Row="3" BusyContent="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=LoadingMsg}">
                <localPage:SIEGLTransGrid x:Name="dgGLTransactions" AutoGenerateColumns="None" SelectionMode="None">
                    <localPage:SIEGLTransGrid.Columns>
                        <localPage:CorasauDataGridTemplateColumnClient x:Name="Date" SortOrder="Descending"/>
                        <localPage:CorasauDataGridTemplateColumnClient x:Name="Account"/>
                        <localPage:CorasauDataGridTemplateColumnClient x:Name="colName" FieldName="Name" />
                        <localPage:CorasauDataGridTemplateColumnClient x:Name="AccountType"/>
                        <localPage:CorasauDataGridTemplateColumnClient x:Name="Amount"/>
                        <localPage:CorasauDataGridTemplateColumnClient x:Name="JournalPostedId"/>
                        <localPage:CorasauDataGridTemplateColumnClient x:Name="Voucher"/>
                        <localPage:CorasauDataGridTemplateColumnClient x:Name="VoucherLine"/>
                        <localPage:CorasauDataGridTemplateColumnClient x:Name="NumberSerie"/>
                        <localPage:CorasauDataGridTemplateColumnClient x:Name="VoucherX"/>
                        <localPage:CorasauDataGridTemplateColumnClient x:Name="Vat"/>
                        <localPage:CorasauDataGridTemplateColumnClient x:Name="AmountVat"/>
                        <localPage:CorasauDataGridTemplateColumnClient x:Name="Currency"/>
                        <localPage:CorasauDataGridTemplateColumnClient x:Name="AmountCur"/>
                        <localPage:CorasauDataGridTemplateColumnClient x:Name="Origin"/>
                        <localPage:CorasauDataGridTemplateColumnClient x:Name="DCType"/>
                        <localPage:CorasauDataGridTemplateColumnClient x:Name="DCAccount"/>
                        <localPage:CorasauDataGridTemplateColumnClient x:Name="DCName"/>
                        <localPage:CorasauDataGridTemplateColumnClient x:Name="Text"/>
                        <localPage:CorasauDataGridTemplateColumnClient x:Name="Qty"/>
                    </localPage:SIEGLTransGrid.Columns>
                    <localPage:SIEGLTransGrid.TotalSummary>
                        <localPage:SumColumn FieldName="Date" SummaryType="Count"/>
                        <localPage:SumColumn FieldName="Qty" SummaryType="Sum" DisplayFormat="{}{0:N2}"/>
                    </localPage:SIEGLTransGrid.TotalSummary>
                </localPage:SIEGLTransGrid>
            </CorasauControls:BusyIndicator>
        </Grid>
    </Grid>
</Pages:GridBasePage>