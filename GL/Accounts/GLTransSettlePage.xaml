                                <localPage:CorasauDataGridTemplateColumnClient x:Name="coldim2" Width="70" FieldName="Dimension2" ShowInColumnChooser="False"/>
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="coldim3" Width="70" FieldName="Dimension3" ShowInColumnChooser="False"/>
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="coldim4" Width="70" FieldName="Dimension4" ShowInColumnChooser="False"/>
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="coldim5" Width="70" FieldName="Dimension5" ShowInColumnChooser="False"/>
