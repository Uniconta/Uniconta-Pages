                                        <StackPanel>
                                            <Image Source="{dx:SvgImageSource Uri=/UnicontaPages;component/Assets/img/Minus_8x8.svg, UsePalette=True}" dx:WpfSvgPalette.Palette="{StaticResource SVGIconPallete}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </docking:LayoutPanel.CaptionTemplate>-->
                        <localPage:TransSettleGrid  x:Name="dgAccountsTransGridSettle" AutoGenerateColumns="None">
                            <localPage:TransSettleGrid.Columns>
                                <localPage:CorasauDataGridTemplateColumnClient FieldName="Date" x:Name="colDate" Width="90"/>
                                <localPage:CorasauDataGridTemplateColumnClient FieldName="Account" x:Name="colAccount" Width="90" Visible="False"/>
                                <localPage:CorasauDataGridTemplateColumnClient FieldName="Name" x:Name="colName" Visible="False"/>
                                <localPage:CorasauDataGridTemplateColumnClient FieldName="NumberSerie" x:Name="colNumberSerie" Width="50" Visible="False" />
                                <localPage:CorasauDataGridTemplateColumnClient FieldName="Voucher" x:Name="colVoucher" Width="60" />
                                <localPage:CorasauDataGridTemplateColumnClient FieldName="JournalPostedId" x:Name="colJournalPostedId" Width="60" />
                                <localPage:CorasauDataGridTemplateColumnClient FieldName="VoucherLine" x:Name="colVoucherLine" Width="50"  Visible="False" />
                                <localPage:CorasauDataGridTemplateColumnClient FieldName="VoucherX" x:Name="colVoucherX" Width="90" Visible="False" />
                                <localPage:CorasauDataGridTemplateColumnClient FieldName="Text" x:Name="colText" Width="200"/>
                                <localPage:CorasauDataGridTemplateColumnClient FieldName="TransType" x:Name="colTransType" Visible="False"/>
                                <localPage:CorasauDataGridTemplateColumnClient FieldName="Debit" x:Name="colDebit"/>
                                <localPage:CorasauDataGridTemplateColumnClient FieldName="Credit" x:Name="colCredit"/>
                                <localPage:CorasauDataGridTemplateColumnClient FieldName="Vat" x:Name="colVat" Width="50" />
                                <localPage:CorasauDataGridTemplateColumnClient FieldName="VatOperation" x:Name="colVatOperation" Width="30" Visible="False" />
                                <localPage:CorasauDataGridTemplateColumnClient FieldName="AmountVat" x:Name="colAmountVat"/>
                                <localPage:CorasauDataGridTemplateColumnClient FieldName="HasVoucher" x:Name="colHasVoucher" Width="50" PrintCellStyle="{StaticResource VoucherColumnLinkPrintingStyle}">
                                    <localPage:CorasauDataGridTemplateColumnClient.HeaderTemplate>
                                        <DataTemplate>
                                            <Image Source="{Binding Converter={StaticResource ImageNameToImagesourceConverter}, ConverterParameter=Attachments_16x16.svg}" Width="16" Height="16" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </localPage:CorasauDataGridTemplateColumnClient.HeaderTemplate>
                                    <localPage:CorasauDataGridTemplateColumnClient.DisplayTemplate>
                                        <ControlTemplate>
                                            <Image Margin="5" Tag="{Binding DataContext.RowData.Row,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Center" Source="{Binding Converter={StaticResource ImageNameToImagesourceConverter}, ConverterParameter=Attachments_16x16.svg}" 
MouseLeftButtonDown="HasVoucherImage_MouseLeftButtonDown" Visibility="{Binding DataContext.RowData.Row.HasVoucher,RelativeSource={RelativeSource TemplatedParent},Converter={StaticResource VisibilityBoolConverter}}" Cursor="Hand"
Stretch="Fill" Width="16" Height="16" RenderOptions.BitmapScalingMode="NearestNeighbor" RenderOptions.EdgeMode="Aliased" />
                                        </ControlTemplate>
                                    </localPage:CorasauDataGridTemplateColumnClient.DisplayTemplate>
                                </localPage:CorasauDataGridTemplateColumnClient>
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="colCurrency" FieldName="Currency" Width="35" Visible="False" />
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="colAmountCur" FieldName="AmountCur" Visible="False"/>
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="colAmountBase" FieldName="AmountBase" Visible="False" />
                                <localPage:CorasauDataGridTemplateColumnClient  x:Name="colOrigin" FieldName="Origin" Width="100" />
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="colDCType" FieldName="DCType" Width="50" />
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="colDCAccount" FieldName="DCAccount"/>
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="colDCName" FieldName="DCName"/>
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="colcolLegalIdent" FieldName="LegalIdent" Visible="False"/>
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="colInvoice" FieldName="Invoice" Width="70"  Visible="False"/>
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="colDocumentDate" FieldName="DocumentDate" Width="85" Visible="False" />
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="colDocumentRef" FieldName="DocumentRef" Width="50" Visible="False" />
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="colAmount" FieldName="Amount" Visible="False"/>
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="colDebitCur" FieldName="DebitCur"  Visible="False"/>
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="colCreditCur" FieldName="CreditCur"  Visible="False"/>
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="colQty" FieldName="Qty" Visible="False" Width="70"/>
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="colReferenceNumber" FieldName="ReferenceNumber" Visible="False" />
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="colCorrection" FieldName="Correction" Width="50" Visible="False"/>
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="colCanceled" FieldName="Canceled" Width="50" Visible="False"/>
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="colAccrued" FieldName="Accrued" Width="50" Visible="False" />
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="colAllocated" FieldName="Allocated" Width="50" Visible="False" />
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="colModified" FieldName="Modified" Width="50" Visible="False" />
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="colPostCalculated" FieldName="PostCalculated" Width="50" Visible="False" />
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="colVatEntered" FieldName="VatEntered" Width="50" Visible="False" />
