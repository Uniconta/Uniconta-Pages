    </UserControl.Resources>
    <Grid x:Name="LayoutRoot" Background="{StaticResource LayoutGridColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <CorasauControls:CorasauRibbonControl XMLSourcePath=";component/Pages/GL/Accounts/GLTransSettlePageGridRibbon.xml" x:Name="localMenu"/>
        <CorasauControls:BusyIndicator x:Name="busyIndicator" Grid.Row="1" BusyContent="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=LoadingMsg}">
            <docking:DockLayoutManager x:Name="DockingControl" AllowCustomization="False">
                <docking:LayoutGroup x:Name="lGroup" AllowDrag="False" AllowDock="False" AllowFloat="False" Orientation="Vertical" AllowContextMenu="False" >
                    <docking:LayoutPanel x:Name="layoutGLTrans" FloatOnDoubleClick="False" AllowDrag="False" AllowDock="False" AllowClose="False" AllowContextMenu="False" AllowMaximize="False" AllowDockToDocumentGroup="False" ShowCloseButton="False"  ShowPinButton="False" ItemHeight="7*">
                        <localPage:TransUpperGrid  x:Name="dgAccountsTransGrid" AutoGenerateColumns="None">
                            <localPage:TransUpperGrid.Columns>
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="colSettle" FieldName="Settle" Header="{Binding Converter={StaticResource GlobalLocalizationValueConverter},ConverterParameter=Settle}" AllowEditing="true" Width="70" AllowAutoFilter="False">
                                    <localPage:CorasauDataGridTemplateColumnClient.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox  VerticalAlignment="Center" HorizontalAlignment="Center" Checked="Settle_Checked" Unchecked="Settle_Unchecked" />
                                        </DataTemplate>
                                    </localPage:CorasauDataGridTemplateColumnClient.CellTemplate>
                                </localPage:CorasauDataGridTemplateColumnClient>
                                <localPage:CorasauDataGridTemplateColumnClient FieldName="Image" Width="40" Visible="False">
                                    <localPage:CorasauDataGridTemplateColumnClient.CellTemplateSelector >
                                        <localPage:VoucherThumbnailTemplateSelector PDFTemplate="{StaticResource VoucherPhotoPdfTemplate}" ImageTemplate="{StaticResource VoucherPhotoImageTemplate}" 
                                                                 EmptyTemplate="{StaticResource VoucherPhotoEmptyTemplate}"/>
                                    </localPage:CorasauDataGridTemplateColumnClient.CellTemplateSelector>
                                </localPage:CorasauDataGridTemplateColumnClient>
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="Date" Width="90"/>
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="Account" Width="90" Visible="False"/>
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="Name" Visible="False"/>
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="NumberSerie" Width="50" Visible="False"/>
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="Voucher" Width="60" AllowThousandMask="False"/>
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="VoucherLine" Width="50" AllowThousandMask="false" Visible="False" />
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="VoucherX" Width="90" Visible="False" />
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="Text" Width="200"/>
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="TransType" Visible="False"/>
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="Debit" Width="90"/>
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="Credit" Width="90"/>
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="SettlementAmount" Width="100"/>
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="StateLocal" Width="40">
                                    <localPage:CorasauDataGridTemplateColumnClient.DisplayTemplate>
                                        <ControlTemplate>
                                            <Image Margin="2" VerticalAlignment="Center" Source="{Binding DataContext.RowData.Row.StateLocal,RelativeSource={RelativeSource TemplatedParent},Converter={StaticResource StateConverter}}" Stretch="Fill" Width="16" Height="16"  />
                                        </ControlTemplate>
                                    </localPage:CorasauDataGridTemplateColumnClient.DisplayTemplate>
                                </localPage:CorasauDataGridTemplateColumnClient>
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="AmountConverted" Visible="False"/>
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="Vat" Width="50" />
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="VatOperation" Width="30" Visible="False" />
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="AmountVat"/>
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="Currency" Width="35" Visible="False" />
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="AmountCur" Visible="False"/>
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="AmountBase" Visible="False" />
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="HasVoucher" Width="30"  PrintCellStyle="{StaticResource VoucherColumnLinkPrintingStyle}">
                                    <localPage:CorasauDataGridTemplateColumnClient.HeaderTemplate>
                                        <DataTemplate>
                                            <Image Source="{Binding Converter={StaticResource ImageNameToImagesourceConverter}, ConverterParameter=Attachments_16x16.svg}" Width="16" Height="16" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </localPage:CorasauDataGridTemplateColumnClient.HeaderTemplate>
                                    <localPage:CorasauDataGridTemplateColumnClient.DisplayTemplate>
                                        <ControlTemplate>
                                            <Image Margin="5" Tag="{Binding DataContext.RowData.Row,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Center" Source="{Binding Converter={StaticResource ImageNameToImagesourceConverter}, ConverterParameter=Attachments_16x16.svg}" Cursor="Hand" MouseLeftButtonDown="HasVoucherImage_MouseLeftButtonDown" Visibility="{Binding DataContext.RowData.Row.HasVoucher,RelativeSource={RelativeSource TemplatedParent},Converter={StaticResource VisibilityBoolConverter}}" Stretch="Fill" Width="16" Height="16" />
                                        </ControlTemplate>
                                    </localPage:CorasauDataGridTemplateColumnClient.DisplayTemplate>
                                </localPage:CorasauDataGridTemplateColumnClient>

                                <localPage:CorasauDataGridTemplateColumnClient x:Name="HasNote" Width="30">
                                    <localPage:CorasauDataGridTemplateColumnClient.HeaderTemplate>
                                        <DataTemplate>
                                            <Image Source="{Binding Converter={StaticResource ImageNameToImagesourceConverter}, ConverterParameter=Note_16x16.svg}" Width="16" Height="16" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </localPage:CorasauDataGridTemplateColumnClient.HeaderTemplate>
                                    <localPage:CorasauDataGridTemplateColumnClient.DisplayTemplate>
                                        <ControlTemplate>
                                            <Image Margin="5" Tag="{Binding DataContext.RowData.Row,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Center" Source="{Binding Converter={StaticResource ImageNameToImagesourceConverter}, ConverterParameter=Note_16x16.svg}" Cursor="Hand" Visibility="{Binding DataContext.RowData.Row.HasNote,RelativeSource={RelativeSource TemplatedParent},Converter={StaticResource VisibilityBoolConverter}}" Stretch="Fill" Width="16" Height="16" />
                                        </ControlTemplate>
                                    </localPage:CorasauDataGridTemplateColumnClient.DisplayTemplate>
                                </localPage:CorasauDataGridTemplateColumnClient>
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="JournalPostedId" Width="50" />
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="Origin" Width="100" />
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="DCType" Width="50" />
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="DCAccount"/>
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="DCName"/>
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="LegalIdent" Visible="False"/>
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="Invoice" Width="70" AllowThousandMask="false" Visible="False"/>
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="DocumentDate" Width="85" Visible="False" />
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="DocumentRef" Width="50" Visible="False" />
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="Amount" Visible="False"/>
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="DebitCur"  Visible="False"/>
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="CreditCur"  Visible="False"/>
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="Qty" Visible="False" Width="70"/>
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="ReferenceNumber" Visible="False" />
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="Project" Width="90" Visible="False" />
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="ProjectName" Visible="False" />
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="Correction" Width="50" Visible="False"/>
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="Canceled" Width="50" Visible="False"/>
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="Accrued" Width="50" Visible="False" />
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="Allocated" Width="50" Visible="False" />
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="Modified" Width="50" Visible="False" />
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="PostCalculated" Width="50" Visible="False" />
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="VatEntered" Width="50" Visible="False" />
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="cldim1" Width="70" FieldName="Dimension1" ShowInColumnChooser="False"/>
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="cldim2" Width="70" FieldName="Dimension2" ShowInColumnChooser="False"/>
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="cldim3" Width="70" FieldName="Dimension3" ShowInColumnChooser="False"/>
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="cldim4" Width="70" FieldName="Dimension4" ShowInColumnChooser="False"/>
                                <localPage:CorasauDataGridTemplateColumnClient x:Name="cldim5" Width="70" FieldName="Dimension5" ShowInColumnChooser="False"/>
                            </localPage:TransUpperGrid.Columns>
                            <localPage:TransUpperGrid.TotalSummary>
                                <localPage:SumColumn FieldName="Amount" SummaryType="Sum" DisplayFormat="{}{0:N2}"/>
                                <localPage:SumColumn FieldName="AmountCur" SummaryType="Sum" DisplayFormat="{}{0:N2}"/>
                                <localPage:SumColumn FieldName="Qty" SummaryType="Sum" DisplayFormat="{}{0:N2}"/>
                            </localPage:TransUpperGrid.TotalSummary>
                        </localPage:TransUpperGrid>
                    </docking:LayoutPanel>
                    <docking:LayoutPanel x:Name="layoutGLTransSettle" FloatOnDoubleClick="False" AllowDrag="False" AllowDock="False" AllowClose="False" AllowContextMenu="False" AllowMaximize="False" AllowDockToDocumentGroup="False" ShowCloseButton="False"  ShowPinButton="False" ItemHeight="3*">
