<CorasauControls:UnicontaBaseWindow x:Class="UnicontaClient.Controls.Dialogs.CWCorrectScannedData"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:CorasauControls="clr-namespace:Uniconta.ClientTools.Controls;assembly=ClientTools"
    MinHeight="520"
    MinWidth="780"
    ShowIcon="False">
    <CorasauControls:BusyIndicator x:Name="busyIndicator">
        <Grid Background="{StaticResource LayoutGridColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  ====== MAIN: Left extraction / Right document ======  -->
            <Grid Grid.Row="0" Margin="10">
                <Grid.ColumnDefinitions>
                    <!--  Left list  -->
                    <ColumnDefinition Width="360" />
                    <!--  Right document  -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  LEFT: Extraction  -->
                <Border Grid.Column="0"
                    Background="{StaticResource LayoutGridColor}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=ExtractedValues}"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Margin="0,0,0,8" />

                        <ListBox x:Name="FieldsList"
                            Grid.Row="2"
                            BorderThickness="0"
                            Background="Transparent"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <Setter Property="Padding" Value="6" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#22FFD400" />
                                            <Setter Property="BorderBrush" Value="#FFFFD400" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Margin="0,0,8,0"
                                            Text="{Binding Label}" />

                                        <TextBox Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            MinHeight="24"
                                            VerticalContentAlignment="Center"
                                            IsReadOnly="True"
                                            IsHitTestVisible="False"
                                            Focusable="False"
                                            BorderThickness="0"
                                            Background="Transparent"
                                            Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                    Background="{StaticResource LayoutGridColor}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10">

                    <!--  Document host with tooltip  -->
                    <Grid x:Name="PageHost"
                        ClipToBounds="True"
                        ToolTipService.ShowDuration="20000"
                        ToolTipService.InitialShowDelay="300">
                        <Grid.ToolTip>
                            <ToolTip>
                                <TextBlock Text="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=CorrectScanResultDocTip}"
                                    TextWrapping="Wrap"
                                    MaxWidth="320" />
                            </ToolTip>
                        </Grid.ToolTip>

                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="PdfPagesItems">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,12">
                                            <Grid>
                                                <Image x:Name="PageImage"
                                                    Source="{Binding Image}"
                                                    Stretch="Uniform"
                                                    SnapsToDevicePixels="True" />

                                                <Canvas x:Name="OverlayCanvas"
                                                    Background="Transparent"
                                                    IsHitTestVisible="True"
                                                    MouseLeftButtonDown="OverlayCanvas_MouseLeftButtonDown" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!--  ====== ROW 2: bottom bar ======  -->
            <Grid Grid.Row="1" Background="{StaticResource LayoutGridColor}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                        Width="28"
                        Height="28"
                        Margin="10,6"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Content="?"
                        FontSize="16"
                        FontWeight="Bold"
                        Click="HowDoesThisWork_Click"
                        ToolTip="Unipedia"
                        ToolTipService.InitialShowDelay="300">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <!--  Right: Continue / Save / Cancel  -->
                    <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="10,6">
                        <Button x:Name="SaveButton"
                            Content="Save"
                            Width="90"
                            Click="SaveButton_Click" />
                        <Button x:Name="CancelButton"
                            Content="Cancel"
                            Width="90"
                            Margin="6,0,0,0"
                            Click="CancelButton_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </CorasauControls:BusyIndicator>
</CorasauControls:UnicontaBaseWindow>
