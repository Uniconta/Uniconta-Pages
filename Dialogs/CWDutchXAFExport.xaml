<ClientTools:ChildWindow x:Class="UnicontaClient.Controls.Dialogs.CWDutchXAFExport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ClientTools="clr-namespace:Uniconta.ClientTools;assembly=ClientTools"
             xmlns:UnicontaCtrls="clr-namespace:Uniconta.ClientTools.Controls;assembly=ClientTools"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             KeyDown="ChildWindow_KeyDown"
             Title="Auditfile Test"
             Width="520"
             Height="420"
             WindowStartupLocation="CenterScreen">
    <Grid x:Name="LayoutRoot" Margin="2" Background="{StaticResource LayoutGridColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="LayoutGrid" Margin="20" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=FileName}" />
            <UnicontaCtrls:TextEditor Grid.Row="0" Grid.Column="2"
                                      Height="23"
                                      Text="{Binding XmlFileName, Mode=TwoWay}" />
            <Button Grid.Row="0" Grid.Column="3"
                    Margin="6,0,0,0"
                    MinWidth="28"
                    Height="23"
                    Content="..."
                    Click="BrowseXmlFile_Click" />
<!--
            <TextBlock Grid.Row="2" Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=Excel}" />
            <UnicontaCtrls:TextEditor Grid.Row="2" Grid.Column="2"
                                      Height="23"
                                      Text="{Binding ExcelFileName, Mode=TwoWay}" />
            <Button Grid.Row="2" Grid.Column="3"
                    Margin="6,0,0,0"
                    MinWidth="28"
                    Height="23"
                    Content="..."
                    Click="BrowseExcelFile_Click" />
-->
            <TextBlock Grid.Row="4" Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=FromDate}" />
            <UnicontaCtrls:DateEditor Grid.Row="4" Grid.Column="2"
                                      Height="23"
                                      Text="{Binding FromDate, Mode=TwoWay}" />

            <TextBlock Grid.Row="6" Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=ToDate}" />
            <UnicontaCtrls:DateEditor Grid.Row="6" Grid.Column="2"
                                      Height="23"
                                      Text="{Binding ToDate, Mode=TwoWay}" />

            <TextBlock Grid.Row="8"
                       Grid.Column="0"
                       Grid.ColumnSpan="4"
                       TextWrapping="Wrap"
                       Text="Leave ExportCode empty to use the default value for that journal." />

            <dxg:GridControl Grid.Row="10"
                             Grid.Column="0"
                             Grid.ColumnSpan="4"
                             ItemsSource="{Binding JournalExportCodes}"
                             AutoGenerateColumns="None">
                <dxg:GridControl.Columns>
                    <dxg:GridColumn FieldName="Journal" Header="Journal" />
                    <dxg:GridColumn FieldName="ExportCode" Header="ExportCode" />
                </dxg:GridControl.Columns>
                <dxg:GridControl.View>
                    <dxg:TableView AutoWidth="True"
                                   ShowGroupPanel="False"
                                   NavigationStyle="Cell"
                                   NewItemRowPosition="Bottom" />
                </dxg:GridControl.View>
            </dxg:GridControl>
        </Grid>

        <StackPanel x:Name="actionButton"
                    HorizontalAlignment="Right"
                    Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0 10 0 0">
            <Button x:Name="OKButton"
                    IsDefault="True"
                    Content="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=OK}"
                    Click="OKButton_Click"
                    MinWidth="75"
                    Height="23"
                    HorizontalAlignment="Right"
                    Margin="0 0 3 0" />
            <Button x:Name="CancelButton"
                    IsCancel="True"
                    Content="{Binding Converter={StaticResource GlobalLocalizationValueConverter}, ConverterParameter=Cancel}"
                    Click="CancelButton_Click"
                    MinWidth="75"
                    Height="23"
                    HorizontalAlignment="Right" />
        </StackPanel>
    </Grid>
</ClientTools:ChildWindow>